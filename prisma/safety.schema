  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum SliderType {
  HOMEPAGE
  VENDORPAGE
}

enum TermsType {
  GENERAL
  PRIVACY_POLICY
  VENDOR_AGREEMENT
  CUSTOMER_TERMS
  DELIVERY_TERMS
  RETURN_POLICY
}

enum WalletTransactionType {
  CREDIT
