  VOUCHER
  COUNTDOWN_DEAL
  FLASH_SALE
  BUY_X_GET_Y
  FREE_SHIPPING
  BUNDLE_DEAL
  SEASONAL_SALE
  LOYALTY_REWARD
  REFERRAL_BONUS
