enum CourierOrderStatus {
  PENDING_PICKUP
  READY_FOR_PICKUP
  PICKUP_PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNING
  RETURNED
  CANCELLED
  ON_HOLD
}
 enum DeliveryType {
