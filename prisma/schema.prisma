  WEBSITE
  ARTICLE
}

enum TwitterCard {
  SUMMARY
  SUMMARY_LARGE_IMAGE
}

enum SitemapChangefreq {
  ALWAYS
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NEVER
}
enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum PaymentInstrumentType {
  BANK
  MOBILE_BANKING
  CARD
  CASH
}

enum MobileBankingProvider {
  BKASH
  NAGAD
  ROCKET
  UPAY
  OTHER
}

model PlatformSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  note      String?
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}


enum VendorReturnStatus {
  CONFIRMED
}

enum WarehouseCourierPickupStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum ReturnCondition {
  SELLABLE
  DAMAGED
}

model VendorReturn {
  id            String             @id @default(cuid())
  vendorOrderId String
  vendorId      String
  condition     ReturnCondition
  status        VendorReturnStatus @default(CONFIRMED)
  refundId      String?
  confirmedBy   String?
  confirmedAt   DateTime           @default(now())
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  vendorOrder VendorOrder        @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  refund      Refund?            @relation(fields: [refundId], references: [id])
  items       VendorReturnItem[]

  @@index([vendorOrderId])
  @@map("vendor_returns")
}

model VendorReturnItem {
  id          String       @id @default(cuid())
  returnId    String
  orderItemId String
  variantId   String
  quantity    Int
  createdAt   DateTime     @default(now())

  return    VendorReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([returnId, orderItemId])
  @@map("vendor_return_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// MARKETING CENTER (Phase 1 — schema only)
//
// Campaigns, flash sale, vendor promotions, coins discount, paid ads and the
// per-order discount breakdown. Money is Decimal(18,4) like Order. Prices are
// never written back onto Product/ProductVariant: campaign and flash prices
// live here and are resolved by the pricing engine, so "revert after the end"
// is automatic. Money history (wallet txns, top-ups, clicks, redemptions,
// discount rows) uses onDelete: Restrict so it can never be cascaded away.
// Reviewer/creator ids are plain columns — the actor of every
// admin action is recorded in AuditLog. CHECK constraints that Prisma cannot
// express are added in the migration SQL.
// ═══════════════════════════════════════════════════════════════════════════

enum MarketingCampaignStatus {
  DRAFT
  PUBLISHED
  ENDED
  CANCELLED
}

enum MarketingReviewStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CampaignInviteStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum FlashSaleSlotStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PromotionType {
  REGULAR_VOUCHER
  OTHER_VOUCHER
  FLEXI_COMBO
  FREE_SHIPPING
}

enum PromotionChannel {
  LIVE_STREAM
  EXTERNAL_SHARE
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum PromotionScope {
  STORE
  PRODUCTS
}

enum PromotionRedemptionStatus {
  APPLIED
  REVERSED
}

enum AdWalletTxnType {
  TOPUP
  AD_SPEND
  REFUND
  ADJUSTMENT
}

enum AdTopupStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_BUDGET
  ENDED
}

enum DiscountSource {
  CAMPAIGN
  FLASH_SALE
  VOUCHER
  FLEXI_COMBO
  FREE_SHIPPING
  COINS
}

enum DiscountLedgerStatus {
  PENDING
  POSTED
  PARTIALLY_REVERSED
  REVERSED
}

enum ItemPriceSource {
  REGULAR
  SPECIAL
  CAMPAIGN
  FLASH_SALE
}

// ── A. Campaigns (admin-created, vendor-joined) ─────────────────────────────

/// The VENDOR PROGRAMME of a campaign landing page (CampaignPage). Name,
/// slug, hero and the live window (startDate/endDate) belong to the page;
/// this record holds only the vendor side: registration window, rules,
/// eligible categories, status and registrations. One per page.
model MarketingCampaign {
  id                   String                      @id @default(cuid())
  campaignPageId       String                      @unique
  registrationStartAt  DateTime
  registrationEndAt    DateTime
  status               MarketingCampaignStatus     @default(DRAFT)
  /// Rules validated server-side on registration.
  minDiscountPercent   Decimal                     @default(0) @db.Decimal(5, 2)
  minStock             Int                         @default(0)
  maxProductsPerVendor Int?
  createdById          String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  categories           MarketingCampaignCategory[]
  invites              MarketingCampaignInvite[]
  registrations        CampaignRegistration[]
  /// Restrict: a page with a vendor programme is never cascaded away.
  campaignPage         CampaignPage                @relation(fields: [campaignPageId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("marketing_campaigns")
}

model MarketingCampaignCategory {
  id         String            @id @default(cuid())
  campaignId String
  categoryId String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
  @@map("marketing_campaign_categories")
}

/// v1: campaigns are open to every eligible vendor. Created now, not used yet.
model MarketingCampaignInvite {
  id          String               @id @default(cuid())
  campaignId  String
  vendorId    String
  maxProducts Int?
  status      CampaignInviteStatus @default(INVITED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  campaign    MarketingCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  vendor      Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, vendorId])
  @@map("marketing_campaign_invites")
}

model CampaignRegistration {
  id              String                @id @default(cuid())
  campaignId      String
  vendorId        String
  productId       String
  variantId       String
  campaignPrice   Decimal               @db.Decimal(18, 4)
  /// Selling price when registered (rule check + audit).
  originalPrice   Decimal               @db.Decimal(18, 4)
  committedStock  Int
  status          MarketingReviewStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  campaign        MarketingCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, variantId])
  @@index([vendorId, status])
  @@index([campaignId, status])
  @@map("campaign_registrations")
}

// ── B. Flash sale ───────────────────────────────────────────────────────────

model FlashSaleSlot {
  id          String              @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  categoryId  String?
  status      FlashSaleSlotStatus @default(SCHEDULED)
  maxItems    Int?
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items       FlashSaleItem[]

  @@index([startAt, endAt])
  @@index([status])
  @@map("flash_sale_slots")
}

model FlashSaleItem {
  id              String                @id @default(cuid())
  slotId          String
  vendorId        String
  productId       String
  variantId       String
  flashPrice      Decimal               @db.Decimal(18, 4)
  originalPrice   Decimal               @db.Decimal(18, 4)
  /// soldQty is reserved with a conditional update (soldQty + n <= stockLimit).
  stockLimit      Int
  soldQty         Int                   @default(0)
  status          MarketingReviewStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  slot            FlashSaleSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([slotId, variantId])
  @@index([vendorId, status])
  @@map("flash_sale_items")
}

// ── C. Vendor promotions (voucher / other voucher / flexi combo / free shipping)

model Promotion {
  id                String                 @id @default(cuid())
  vendorId          String
  type              PromotionType
  name              String
  /// Vouchers only. Globally unique so a customer can enter it without a store.
  code              String?                @unique
  channel           PromotionChannel?
  discountType      PromotionDiscountType?
  discountValue     Decimal?               @db.Decimal(18, 4)
  maxDiscount       Decimal?               @db.Decimal(18, 4)
  minSpend          Decimal                @default(0) @db.Decimal(18, 4)
  usageLimitTotal   Int?
  usageLimitPerUser Int?
  usedCount         Int                    @default(0)
  scope             PromotionScope         @default(STORE)
  startAt           DateTime
  endAt             DateTime
  status            PromotionStatus        @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  vendor            Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products          PromotionProduct[]
  comboTiers        FlexiComboTier[]
  redemptions       PromotionRedemption[]

  @@index([vendorId, status])
  @@index([type, status, startAt, endAt])
  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@map("promotion_products")
}

/// Buy more, save more: the best tier the basket reaches applies.
model FlexiComboTier {
  id            String                @id @default(cuid())
  promotionId   String
  sortOrder     Int
  minQuantity   Int?
  minAmount     Decimal?              @db.Decimal(18, 4)
  discountType  PromotionDiscountType
  discountValue Decimal               @db.Decimal(18, 4)
  promotion     Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, sortOrder])
  @@map("flexi_combo_tiers")
}

model PromotionRedemption {
  id             String                    @id @default(cuid())
  promotionId    String
  orderId        String
  vendorOrderId  String?
  userId         String
  amount         Decimal                   @db.Decimal(18, 4)
  idempotencyKey String                    @unique
  status         PromotionRedemptionStatus @default(APPLIED)
  createdAt      DateTime                  @default(now())
  reversedAt     DateTime?
  promotion      Promotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder    VendorOrder?              @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([promotionId, userId])
  @@index([orderId])
  @@map("promotion_redemptions")
}

// ── D. Coins discount (coins = CustomerProfile.loyaltyPoints; 100 coins = ৳1)

model VendorCoinsSetting {
  id                 String    @id @default(cuid())
  vendorId           String    @unique
  /// 0 (off), 3, 5 or 7 — the rate currently applied.
  ratePercent        Int       @default(0)
  /// Opt in/out request; becomes ratePercent at pendingEffectiveAt (≤24h).
  pendingRatePercent Int?
  pendingEffectiveAt DateTime?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([pendingEffectiveAt])
  @@map("vendor_coins_settings")
}

model VendorCoinsSettingHistory {
  id            String   @id @default(cuid())
  vendorId      String
  fromRate      Int
  toRate        Int
  requestedAt   DateTime @default(now())
  effectiveAt   DateTime
  requestedById String?
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, requestedAt])
  @@map("vendor_coins_setting_history")
}

/// Seller-funded vs platform-subsidy split per store rate.
model CoinsFundingRule {
  id                   String   @id @default(cuid())
  ratePercent          Int
  sellerSharePercent   Decimal  @db.Decimal(5, 2)
  platformSharePercent Decimal  @db.Decimal(5, 2)
  effectiveFrom        DateTime @default(now())
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([ratePercent, isActive, effectiveFrom])
  @@map("coins_funding_rules")
}

// ── E. Paid ads (replaces the unused Advertisement table) ───────────────────

model VendorAdWallet {
  id        String              @id @default(cuid())
  vendorId  String              @unique
  /// Never below zero (CHECK constraint + conditional debit).
  balance   Decimal             @default(0) @db.Decimal(18, 4)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  txns      VendorAdWalletTxn[]
  topups    AdTopupPayment[]

  @@map("vendor_ad_wallets")
}

model VendorAdWalletTxn {
  id               String          @id @default(cuid())
  walletId         String
  vendorId         String
  type             AdWalletTxnType
  /// Positive; the direction follows from `type`.
  amount           Decimal         @db.Decimal(18, 4)
  balanceAfter     Decimal         @db.Decimal(18, 4)
  idempotencyKey   String          @unique
  adTopupPaymentId String?
  adCampaignId     String?
  adClickId        String?
  note             String?
  createdById      String?
  createdAt        DateTime        @default(now())
  wallet           VendorAdWallet  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  vendor           Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  topupPayment     AdTopupPayment? @relation(fields: [adTopupPaymentId], references: [id], onDelete: SetNull)
  adCampaign       AdCampaign?     @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  adClick          AdClick?        @relation(fields: [adClickId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([walletId, createdAt])
  @@map("vendor_ad_wallet_txns")
}

/// Wallet top-up via the payment gateway — separate from Payment (orders only).
model AdTopupPayment {
  id             String              @id @default(cuid())
  vendorId       String
  walletId       String
  amount         Decimal             @db.Decimal(18, 4)
  gateway        String
  status         AdTopupStatus       @default(PENDING)
  transactionId  String?             @unique
  gatewayMeta    Json?
  idempotencyKey String              @unique
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  wallet         VendorAdWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTxns     VendorAdWalletTxn[]

  @@index([vendorId, status])
  @@map("ad_topup_payments")
}

model AdCampaign {
  id             String              @id @default(cuid())
  vendorId       String
  name           String
  status         AdCampaignStatus    @default(DRAFT)
  dailyBudget    Decimal             @db.Decimal(18, 4)
  bidCpc         Decimal             @db.Decimal(18, 4)
  startAt        DateTime
  endAt          DateTime?
  /// Reset by the daily budget job.
  spentToday     Decimal             @default(0) @db.Decimal(18, 4)
  spentTodayDate DateTime?           @db.Date
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products       AdCampaignProduct[]
  clicks         AdClick[]
  dailyStats     AdDailyStat[]
  walletTxns     VendorAdWalletTxn[]

  @@index([vendorId, status])
  @@index([status, startAt])
  @@map("ad_campaigns")
}

model AdCampaignProduct {
  id           String     @id @default(cuid())
  adCampaignId String
  productId    String
  adCampaign   AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([adCampaignId, productId])
  @@map("ad_campaign_products")
}

model AdClick {
  id            String              @id @default(cuid())
  adCampaignId  String
  productId     String
  vendorId      String
  /// Hashed user/session key — no raw identifiers.
  viewerKey     String
  chargedAmount Decimal             @db.Decimal(18, 4)
  /// campaign + product + viewer + time window: one charge per window.
  dedupeKey     String              @unique
  createdAt     DateTime            @default(now())
  adCampaign    AdCampaign          @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  walletTxns    VendorAdWalletTxn[]

  @@index([adCampaignId, createdAt])
  @@map("ad_clicks")
}

model AdDailyStat {
  id           String     @id @default(cuid())
  adCampaignId String
  productId    String
  date         DateTime   @db.Date
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  orders       Int        @default(0)
  spend        Decimal    @default(0) @db.Decimal(18, 4)
  revenue      Decimal    @default(0) @db.Decimal(18, 4)
  adCampaign   AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([adCampaignId, productId, date])
  @@map("ad_daily_stats")
}

// ── F. Per-order discount breakdown (drives the ledger) ─────────────────────

/// One row per discount applied to an order line (or to a vendor order's
/// shipping for FREE_SHIPPING, where orderItemId is null). Seller-funded
/// amounts hit the vendor payable when the line is DELIVERED and are
/// reversed (fully or per returned quantity) on cancel/return.
model OrderItemDiscount {
  id             String               @id @default(cuid())
  orderId        String
  vendorOrderId  String
  orderItemId    String?
  vendorId       String
  source         DiscountSource
  sourceId       String?
  amount         Decimal              @db.Decimal(18, 4)
  sellerFunded   Decimal              @db.Decimal(18, 4)
  platformFunded Decimal              @db.Decimal(18, 4)
  reversedAmount Decimal              @default(0) @db.Decimal(18, 4)
  ledgerStatus   DiscountLedgerStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder    VendorOrder          @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([vendorId, ledgerStatus])
  @@map("order_item_discounts")
}


// ============================================================
// BUSINESS ADVISOR ANALYTICS
// One row per recorded shopping-journey event. Written ONLY by the server:
// vendorId / productId are always derived from the product, cart line or
// order in the database (never from a client-supplied vendor id). Holds no
// names, emails, phones, addresses, tokens, cookies or payment data — the
// actor is a pseudonymous key. No foreign keys on purpose: analytics must
// never block or cascade into catalogue / order writes. Retention: rows
// older than ANALYTICS_RETENTION_DAYS (default 180) are purged.
// ============================================================

enum AnalyticsEventType {
  PRODUCT_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  CART_QUANTITY_CHANGED
  CHECKOUT_STARTED
  CHECKOUT_FAILED
  ORDER_PLACED
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  occurredAt DateTime           @default(now())
  /// Calendar day in Asia/Dhaka (UTC+6): the bucket for daily trends and date filters.
  day        DateTime           @db.Date
  vendorId   String
  productId  String
  variantId  String?
  /// Journey key: the browser's analytics session id, or a per-actor-per-day key when none was sent.
  sessionKey String
  /// Pseudonymous actor: "v:<visitor id>" (anonymous browser) or "u:<sha256 of user id>" (signed in).
  actorKey   String
  /// Correlates the rows of one checkout attempt (one row per product line).
  groupKey   String?
  orderId    String?
  quantity   Int?
  /// Line value in minor units (paisa) at placement — ORDER_PLACED only.
  valueMinor Int?
  /// Allowlisted entry point (PRODUCT_PAGE, QUICK_VIEW, BUY_NOW, CART, CHECKOUT, WISHLIST).
  source     String?
  /// Allowlisted failure category — CHECKOUT_FAILED only (never a raw error message).
  reason     String?
  /// Idempotency: the same logical event is stored once (createMany skipDuplicates).
  dedupKey   String             @unique
  createdAt  DateTime           @default(now())

  @@index([vendorId, day, type])
  @@index([vendorId, productId, day])
  @@index([vendorId, sessionKey])
  @@index([sessionKey, occurredAt])
  @@index([actorKey, occurredAt])
  @@index([day, type])
  @@map("analytics_events")
}

// Visual session replay (src/modules/analytics/session-replay.*).

/// One rrweb recording of a browser session. Linked to the Business Advisor
/// journey through the same analytics session key ("s:<session id>").
/// Admin-only to watch; synthetic (tester-opted-in) recordings only in phase 1.
model SessionRecording {
  id              String    @id @default(cuid())
  /// Same journey key as AnalyticsEvent.sessionKey.
  sessionKey      String
  /// journeyLabel(sessionKey), e.g. "J-0A1B2C3D" — what Business Advisor shows.
  journeyLabel    String
  /// Pseudonymous actor ("v:<visitor id>" / "u:<hash>"), as in AnalyticsEvent.
  actorKey        String
  /// sha256 of the random upload token handed to the recording browser.
  uploadTokenHash String
  synthetic       Boolean   @default(true)
  /// RECORDING | COMPLETE | STOPPED
  status          String    @default("RECORDING")
  /// max_chunks | max_bytes | max_duration
  stopReason      String?
  /// First page path (no query string).
  entryPath       String?
  startedAt       DateTime  @default(now())
  firstEventAt    DateTime?
  lastEventAt     DateTime?
  chunkCount      Int       @default(0)
  eventCount      Int       @default(0)
  /// Compressed bytes stored.
  bytes           Int       @default(0)
  pageCount       Int       @default(0)
  /// Deleted by the analytics retention job after this instant.
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  chunks SessionRecordingChunk[]

  @@index([journeyLabel, startedAt])
  @@index([sessionKey])
  @@index([startedAt])
  @@index([expiresAt])
  @@index([status, startedAt])
  @@map("session_recordings")
}

/// One uploaded batch of rrweb events; the body is in private object storage.
model SessionRecordingChunk {
  id           String   @id @default(cuid())
  recordingId  String
  seq          Int
  storageKey   String
  bytes        Int
  eventCount   Int
  firstEventAt DateTime
  lastEventAt  DateTime
  createdAt    DateTime @default(now())

  recording SessionRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, seq])
  @@map("session_recording_chunks")
}

// ── Email & SMS campaigns (proposed 20261022120000) ──────────────────────
// PROPOSED ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â NOT APPLIED. Add to prisma/schema.prisma together with the migration.
// Email & SMS campaigns ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â revision 4 (approved corrections applied).
//
// INTEGRATION NOTE: the User model needs one back-relation when this is adopted:
//   model User { ... emailSmsRecipients EmailSmsCampaignRecipient[] }
// Nothing else in the existing schema changes.

enum EmailSmsChannel {
  EMAIL
  SMS
}

enum EmailSmsCampaignType {
  WELCOME
  PROMOTIONAL
  TRANSACTIONAL
  REMINDER
}

enum EmailSmsCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SUBMITTED
  COMPLETED
  CANCELLED
  FAILED
}

/// How a campaign selects its audience. Deliberately separate from
/// EmailSmsRecipientSource: audience kind is a campaign property, source is a row's
/// provenance. CUSTOM exists in the enum but stays unused in v1.
enum EmailSmsAudienceKind {
  USER
  SEGMENT
  CUSTOM
}

enum EmailSmsRecipientSource {
  USER
  SEGMENT
  CUSTOM
}

/// QUEUED     row exists, no provider call yet
/// SUBMITTED  provider accepted the message (acknowledgement only)
/// DELIVERED  provider delivery receipt received ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â unreachable until receipts exist
/// BOUNCED    provider reported a bounce
/// FAILED     gave up; errorCode says why
enum EmailSmsSendState {
  QUEUED
  SUBMITTED
  RECONCILIATION_REQUIRED
  DELIVERED
  BOUNCED
  FAILED
}

enum EmailSmsSuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

/// How a suppression was learned; PROVIDER_EVENT requires a real provider callback.
enum EmailSmsSuppressionSource {
  ADMIN
  USER_REQUEST
  PROVIDER_EVENT
}

enum EmailSmsActivityKind {
  CREATED
  SCHEDULED
  STARTED
  SUBMITTED
  COMPLETED
  CANCELLED
  FAILED
}

/// Soft-deleted rather than removed; campaigns reference it with RESTRICT so a
/// template can never silently vanish from history.
model EmailSmsCampaignTemplate {
  id          String           @id @default(cuid())
  name        String
  channel     EmailSmsChannel
  subject     String?
  body        String
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  campaigns EmailSmsCampaign[]

  @@index([channel, deletedAt])
  @@map("email_sms_campaign_templates")
}

model EmailSmsCampaign {
  id       String                  @id @default(cuid())
  name     String
  channel  EmailSmsChannel
  type     EmailSmsCampaignType    @default(PROMOTIONAL)
  status   EmailSmsCampaignStatus  @default(DRAFT)

  templateId           String?
  /// Immutable copy of what was sent; later template edits cannot rewrite history.
  subjectSnapshot      String?
  bodySnapshot         String
  templateNameSnapshot String?

  audienceKind EmailSmsAudienceKind @default(USER)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  /// Caller-supplied; a retried create cannot duplicate a campaign.
  idempotencyKey String  @unique
  /// Fencing token: every send/state write must match this, so a worker whose
  /// lease expired cannot overwrite the worker that replaced it.
  claimToken     String?
  claimedAt      DateTime?
  createdById    String?

  /// Soft delete only. Hard-deleting a campaign cascades recipients and sends away.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template   EmailSmsCampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients EmailSmsCampaignRecipient[]
  sends      EmailSmsCampaignSend[]
  activity   EmailSmsCampaignActivity[]

  @@index([status, scheduledAt])
  @@index([channel, createdAt])
  @@index([claimToken])
  @@index([deletedAt])
  @@map("email_sms_campaigns")
}

/// addressHash = sha256(normalised address) for de-duplication only.
/// addressCipher = "v1:<b64 iv>:<b64 tag>:<b64 ciphertext>" (AES-256-GCM, 12-byte
/// IV per row, key from CAMPAIGN_ADDRESS_KEY). Plaintext is never stored or logged.
model EmailSmsCampaignRecipient {
  id            String                @id @default(cuid())
  campaignId    String
  source        EmailSmsRecipientSource
  /// SET NULL on user deletion: the send history survives, the account does not.
  userId        String?
  addressHash   String
  addressCipher String
  suppressed    Boolean               @default(false)
  createdAt     DateTime              @default(now())

  campaign EmailSmsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sends    EmailSmsCampaignSend[]

  @@unique([campaignId, addressHash])
  @@index([campaignId, suppressed])
  @@index([userId])
  @@map("email_sms_campaign_recipients")
}

/// One row per attempt. Retries append a new attempt row; (recipientId, attempt) is
/// unique so the same attempt cannot be recorded twice.
model EmailSmsCampaignSend {
  id                String            @id @default(cuid())
  campaignId        String
  recipientId       String
  attempt           Int               @default(1)
  state             EmailSmsSendState @default(QUEUED)
  provider          String?
  providerMessageId String?           @unique
  errorCode         String?
  /// Redacted and truncated before persistence ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â provider text may contain PII.
  errorMessage      String?
  submittedAt       DateTime?
  /// Written immediately BEFORE the provider call. NULL = no transmission attempted,
  /// which is the only retryable condition after a crash.
  transmitStartedAt DateTime?
  /// Only set from a provider delivery receipt, never from submission success.
  deliveredAt       DateTime?
  /// Manual resolution of an ambiguous outcome (ADMIN only, provider evidence required).
  resolutionNote    String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  campaign  EmailSmsCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient EmailSmsCampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, attempt])
  @@index([campaignId, state])
  @@map("email_sms_campaign_sends")
}

model EmailSmsCampaignActivity {
  id         String              @id @default(cuid())
  campaignId String
  kind       EmailSmsActivityKind
  message    String
  actorId    String?
  createdAt  DateTime            @default(now())

  /// RESTRICT: the audit trail must outlive the campaign record.
  campaign EmailSmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId, createdAt])
  @@map("email_sms_campaign_activity")
}

/// Keyed HMAC of the normalised address (CAMPAIGN_ADDRESS_HASH_KEY, separate from
/// CAMPAIGN_ADDRESS_KEY). No plaintext address is ever stored here.
model EmailSmsSuppression {
  id          String                       @id @default(cuid())
  addressHash String
  channel     EmailSmsChannel
  reason      EmailSmsSuppressionReason
  source      EmailSmsSuppressionSource
  createdById String?
  createdAt   DateTime                     @default(now())

  events EmailSmsSuppressionEvent[]

  @@unique([channel, addressHash])
  @@index([addressHash])
  @@map("email_sms_suppressions")
}

/// Append-only audit. Duplicate provider events are deduplicated by the partial
/// unique index below (SQL-managed Ã¢â‚¬â€ Prisma cannot express a partial index), so a
/// repeat delivery is counted in metrics and logged, never stored twice.
model EmailSmsSuppressionEvent {
  id              String                   @id @default(cuid())
  suppressionId   String?
  addressHash     String
  channel         EmailSmsChannel
  reason          EmailSmsSuppressionReason
  source          EmailSmsSuppressionSource
  providerEventId String?
  actorId         String?
  createdAt       DateTime                 @default(now())

  suppression EmailSmsSuppression? @relation(fields: [suppressionId], references: [id], onDelete: SetNull)

  @@index([addressHash, createdAt])
  @@map("email_sms_suppression_events")
}

/// Rotation state for the suppression HMAC key. A version becomes usable only when
/// it is COMPLETE *and* an independent verifier has written verifiedAt/verifiedById â€”
/// a worker cannot promote its own version.
enum EmailSmsHashVersionState {
  PENDING
  BACKFILLING
  COMPLETE
  RETIRED
}

model EmailSmsHashVersion {
  version           Int                     @id
  state             EmailSmsHashVersionState @default(PENDING)
  /// True for the single version used to hash NEW rows.
  isWriteVersion    Boolean                 @default(false)
  /// True while lookups must consult this version (COMPLETE or RETIRED).
  lookupEnabled     Boolean                 @default(false)
  keyAlias          String
  startedAt         DateTime?
  backfillStartedAt DateTime?
  /// Rows created before this instant are the backfill population; later rows are
  /// dual-written at insert time, so completeness is measured against a boundary.
  backfilledBefore  DateTime?
  lastProcessedId   String?
  attempts          Int                     @default(0)
  lastError         String?
  verifiedAt        DateTime?
  verifiedById      String?
  verificationRunId String?
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([state])
  @@map("email_sms_hash_versions")
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT COMMISSION SYSTEM (docs/agent-system-plan.md)
//
// Agents are a separate identity (NOT User rows): own table, own tokens.
// Every commission rule is admin-controlled data — nothing is hardcoded:
//   agent_settings              key/value settings (validated server-side)
//   agent_levels                level CRUD (thresholds, commission %, bonus)
//   agent_commission_overrides  per vendor / agent / category rates
//   agent_bonus_rules           milestone bonuses
// Every configuration change writes agent_config_audits in the same
// transaction. Commission rows SNAPSHOT the rate/rules they were created
// with; no code path updates those columns afterwards.
// Money: Decimal(18,2) for amounts, Decimal(18,4) for bases copied from
// order lines, Decimal(9,4) for percentages. CHECK constraints and partial
// unique indexes that Prisma cannot express live in the migration SQL.
// ═══════════════════════════════════════════════════════════════════════════

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AgentVendorLinkSource {
  REFERRAL_CODE
  AGENT_INVITE
  ADMIN_ASSIGNED
}

enum AgentConfigEntity {
  SETTING
  LEVEL
  OVERRIDE
  BONUS_RULE
  AGENT
  VENDOR_LINK
  WITHDRAWAL
  COMMISSION
  TRAINING
  WALLET
  BONUS_AWARD
}

enum AgentConfigAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  STATUS
  RERUN
}

enum AgentRateSource {
  VENDOR
  AGENT
  CATEGORY
  LEVEL
  GLOBAL
}

enum AgentOverrideScope {
  VENDOR
  AGENT
  CATEGORY
}

enum AgentBonusScope {
  PER_VENDOR
  PER_AGENT
}

enum AgentBonusMetric {
  DELIVERED_ORDERS
  DELIVERED_SALES
  ACTIVE_VENDORS
  NEW_VENDORS
}

enum AgentBonusRecurrence {
  ONE_TIME
  MONTHLY
}

enum AgentCommissionStatus {
  PENDING_CLEARANCE
  AVAILABLE
  PARTIALLY_REVERSED
  REVERSED
}

enum AgentWalletTxType {
  COMMISSION_CREDIT
  COMMISSION_REVERSAL
  BONUS_CREDIT
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  WITHDRAWAL_PAID
  ADJUSTMENT
}

enum AgentPayoutMethodType {
  BKASH
  NAGAD
  BANK
}

enum AgentWithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Agent {
  id                String      @id @default(cuid())
  /// Human-facing id, e.g. AG-7K3Q9P (unique).
  agentCode         String      @unique
  name              String
  /// Stored lowercase/trimmed.
  email             String      @unique
  /// Stored normalized (01XXXXXXXXX).
  phone             String?     @unique
  passwordHash      String
  status            AgentStatus @default(PENDING)
  avatar            String?
  referralCode      String      @unique
  levelId           String?
  /// Incremented on suspend / password change / log-out-everywhere; every
  /// access token carries it and is refused once it no longer matches.
  tokenVersion      Int         @default(0)
  notificationPrefs Json        @default("{}")
  emailVerifiedAt   DateTime?
  approvedById      String?
  approvedAt        DateTime?
  /// Reason for the latest SUSPENDED / DEACTIVATED status.
  statusReason      String?
  lastLoginAt       DateTime?
  /// Admin User.id that created the agent; null = self-registered.
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  level          AgentLevel?               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  sessions       AgentSession[]
  passwordResets AgentPasswordReset[]
  vendorLinks    AgentVendorLink[]
  overrides      AgentCommissionOverride[]
  commissions    AgentCommission[]
  wallet         AgentWallet?
  walletTxs      AgentWalletTransaction[]
  payoutMethods  AgentPayoutMethod[]
  withdrawals    AgentWithdrawal[]
  bonusAwards    AgentBonusAward[]
  chatParticipants ConversationParticipant[] @relation("AgentChatParticipants")
  chatMessages     Message[]                 @relation("AgentChatMessages")

  @@index([status])
  @@index([levelId])
  @@map("agents")
}

model AgentSession {
  id               String    @id @default(cuid())
  agentId          String
  /// SHA-256 of the refresh token; the raw token is never stored.
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, revokedAt])
  @@map("agent_sessions")
}

model AgentPasswordReset {
  id        String    @id @default(cuid())
  agentId   String
  /// SHA-256 of the emailed token; single use.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_password_resets")
}

/// Which agent a vendor belongs to, with history. At most ONE open link per
/// vendor (partial unique index on vendorId WHERE endedAt IS NULL).
model AgentVendorLink {
  id           String                @id @default(cuid())
  agentId      String
  vendorId     String
  source       AgentVendorLinkSource
  startedAt    DateTime              @default(now())
  endedAt      DateTime?
  assignedById String?
  endedById    String?
  note         String?
  createdAt    DateTime              @default(now())

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)
  vendor Vendor @relation("VendorAgentLinks", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([agentId, endedAt])
  @@index([vendorId])
  @@map("agent_vendor_links")
}

/// Admin-controlled settings, one row per key. Keys and value shapes are
/// validated by the settings registry (agent-settings.service.ts). Rows exist
/// only once an admin saved them — nothing is seeded.
model AgentSetting {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agent_settings")
}

/// Append-only audit of every agent configuration change. No FK to User on
/// purpose: deleting a user must never delete this history.
model AgentConfigAudit {
  id          String            @id @default(cuid())
  entity      AgentConfigEntity
  entityId    String
  action      AgentConfigAction
  oldValue    Json?
  newValue    Json?
  actorUserId String
  actorName   String?
  ip          String?
  userAgent   String?
  createdAt   DateTime          @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@map("agent_config_audits")
}

model AgentLevel {
  id                  String   @id @default(cuid())
  name                String   @unique
  /// Higher rank = higher level. Unique.
  rank                Int      @unique
  minActiveVendors    Int      @default(0)
  minDeliveredSales   Decimal  @default(0) @db.Decimal(18, 2)
  minPerformanceScore Decimal? @db.Decimal(5, 2)
  /// null = this level has no rate of its own (resolution falls through).
  commissionPercent   Decimal? @db.Decimal(9, 4)
  /// One-time bonus on reaching the level (awarded in P9); null = none.
  bonusAmount         Decimal? @db.Decimal(18, 2)
  perks               Json     @default("[]")
  isActive            Boolean  @default(true)
  createdById         String
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agents Agent[]

  @@index([isActive, rank])
  @@map("agent_levels")
}

/// Rate override for one vendor, one agent or one category. The rate is
/// immutable — a change ends this row and creates a new one. At most one
/// active override per target (partial unique indexes in the migration).
model AgentCommissionOverride {
  id            String             @id @default(cuid())
  scope         AgentOverrideScope
  vendorId      String?
  agentId       String?
  categoryId    String?
  ratePercent   Decimal            @db.Decimal(9, 4)
  effectiveFrom DateTime           @default(now())
  effectiveTo   DateTime?
  isActive      Boolean            @default(true)
  note          String?
  createdById   String
  endedById     String?
  endedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  vendor   Vendor?   @relation("VendorAgentOverrides", fields: [vendorId], references: [id], onDelete: Cascade)
  agent    Agent?    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  category Category? @relation("CategoryAgentOverrides", fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([vendorId])
  @@index([agentId])
  @@index([categoryId])
  @@map("agent_commission_overrides")
}

model AgentBonusRule {
  id          String               @id @default(cuid())
  name        String
  description String?
  scope       AgentBonusScope
  metric      AgentBonusMetric
  /// Order count, ৳ amount or vendor count, depending on metric.
  threshold   Decimal              @db.Decimal(18, 2)
  amount      Decimal              @db.Decimal(18, 2)
  recurrence  AgentBonusRecurrence
  validFrom   DateTime             @default(now())
  validTo     DateTime?
  isActive    Boolean              @default(true)
  createdById String
  updatedById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  awards AgentBonusAward[]

  @@index([isActive])
  @@map("agent_bonus_rules")
}

model AgentBonusAward {
  id           String   @id @default(cuid())
  ruleId       String
  agentId      String
  /// Vendor id for PER_VENDOR rules, "" for PER_AGENT rules.
  vendorKey    String   @default("")
  /// "ALL" for ONE_TIME rules, "YYYY-MM" for MONTHLY rules.
  periodKey    String
  amount       Decimal  @db.Decimal(18, 2)
  ruleSnapshot Json
  awardedAt    DateTime @default(now())

  rule  AgentBonusRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  agent Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([ruleId, agentId, vendorKey, periodKey])
  @@index([agentId])
  @@map("agent_bonus_awards")
}

/// One row per delivered consignment line (deliveryId = CourierOrder.id).
/// Order references are plain ids on purpose: this is a ledger and must
/// survive whatever happens to the order rows.
model AgentCommission {
  id             String                @id @default(cuid())
  agentId        String
  vendorId       String
  orderId        String
  vendorOrderId  String
  orderItemId    String
  deliveryId     String
  quantity       Int
  baseAmount     Decimal               @db.Decimal(18, 4)
  amount         Decimal               @db.Decimal(18, 2)
  // ── snapshot: written once at creation, never updated ──
  rateSource     AgentRateSource
  rateRefId      String?
  ratePercent    Decimal               @db.Decimal(9, 4)
  levelId        String?
  levelName      String?
  holdDays       Int
  durationMonths Int?
  ruleSnapshot   Json
  // ── lifecycle ──
  reversedQty    Int                   @default(0)
  reversedAmount Decimal               @default(0) @db.Decimal(18, 2)
  status         AgentCommissionStatus @default(PENDING_CLEARANCE)
  earnedAt       DateTime              @default(now())
  availableAt    DateTime
  /// Phase 7: set once when the amount is credited to the wallet ledger.
  walletCreditedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  agent     Agent                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  reversals AgentCommissionReversal[]

  @@unique([deliveryId, orderItemId])
  @@index([agentId, status])
  @@index([agentId, earnedAt])
  @@index([agentId, walletCreditedAt, availableAt])
  @@index([vendorId])
  @@index([orderId])
  @@map("agent_commissions")
}

model AgentCommissionReversal {
  id             String   @id @default(cuid())
  commissionId   String
  vendorReturnId String
  quantity       Int
  amount         Decimal  @db.Decimal(18, 2)
  /// Phase 7: set once when debited from the wallet ledger.
  walletPostedAt DateTime?
  createdAt      DateTime @default(now())

  commission AgentCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@unique([commissionId, vendorReturnId])
  @@index([walletPostedAt])
  @@map("agent_commission_reversals")
}

/// Cached balances; always equal to the sum of agent_wallet_transactions.
/// Row-locked (SELECT … FOR UPDATE) inside every money mutation.
model AgentWallet {
  agentId          String   @id
  available        Decimal  @default(0) @db.Decimal(18, 2)
  pendingClearance Decimal  @default(0) @db.Decimal(18, 2)
  onHold           Decimal  @default(0) @db.Decimal(18, 2)
  totalEarned      Decimal  @default(0) @db.Decimal(18, 2)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt        DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@map("agent_wallets")
}

model AgentWalletTransaction {
  id           String            @id @default(cuid())
  agentId      String
  type         AgentWalletTxType
  /// Signed: credits positive, debits negative.
  amount       Decimal           @db.Decimal(18, 2)
  refType      String
  refId        String
  balanceAfter Decimal           @db.Decimal(18, 2)
  note         String?
  createdById  String?
  createdAt    DateTime          @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([type, refType, refId])
  @@index([agentId, createdAt])
  @@map("agent_wallet_transactions")
}

model AgentPayoutMethod {
  id            String                @id @default(cuid())
  agentId       String
  type          AgentPayoutMethodType
  accountName   String
  accountNumber String
  bankName      String?
  branch        String?
  routingNumber String?
  isDefault     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  agent       Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  withdrawals AgentWithdrawal[]

  @@index([agentId])
  @@map("agent_payout_methods")
}

model AgentWithdrawal {
  id              String                @id @default(cuid())
  agentId         String
  amount          Decimal               @db.Decimal(18, 2)
  fee             Decimal               @default(0) @db.Decimal(18, 2)
  netAmount       Decimal               @db.Decimal(18, 2)
  payoutMethodId  String?
  methodSnapshot  Json
  /// Settings in force when requested (limits, fee) — snapshot.
  settingsSnapshot Json
  status          AgentWithdrawalStatus @default(REQUESTED)
  clientRequestId String
  autoApproved    Boolean               @default(false)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectReason    String?
  paidById        String?
  paidAt          DateTime?
  transactionRef  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Restrict)
  payoutMethod AgentPayoutMethod? @relation(fields: [payoutMethodId], references: [id], onDelete: SetNull)

  @@unique([agentId, clientRequestId])
  @@index([status, createdAt])
  @@map("agent_withdrawals")
}

model AgentTrainingResource {
  id          String   @id @default(cuid())
  category    String
  title       String
  summary     String?
  body        String?
  url         String?
  coverImage  String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category])
  @@map("agent_training_resources")
}


// ═══════════════════════════════════════════════════════════════════════════
// Subscription platform (2026-11) — dynamic plans, features, prices, offers.
// docs/subscription-payout-audit.md. Nothing here is hardcoded: plans, features,
// limits, cycles and prices are admin data. POS keeps its own PosSubscription;
// a plan that includes the "pos" feature also opens the POS (additive).
// ═══════════════════════════════════════════════════════════════════════════

enum SubPackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubPackageVisibility {
  PUBLIC
  HIDDEN
}

enum VendorSubStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum VendorSubSource {
  TRIAL
  PAID
  COMPLIMENTARY
  OFFER
  ADMIN
}

enum SubOfferKind {
  PRICE_OVERRIDE
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  FREE_PLAN
  FREE_FEATURE
}

enum SubOfferStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

enum SubOfferAfterExpiry {
  NORMAL_PRICE
  PREVIOUS_SUBSCRIPTION
  SWITCH_PLAN
  DISABLE_FEATURE
  MANUAL_RENEWAL
}

enum SubPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// A capability that plans can include (POS, Virtual Try-On, Accounting…).
model SubscriptionFeature {
  id          String   @id @default(cuid())
  /// Stable key used by the backend gate, e.g. "pos", "virtual_try_on".
  key         String   @unique
  name        String
  description String?
  icon        String?
  color       String?
  category    String?
  /// Admin-defined configurable limits: [{ key, label, type: "number" | "boolean", unit?, period?: "MONTH" }]
  limitDefs   Json     @default("[]")
  /// When false the backend gate is in monitor mode for this feature (never blocks).
  enforced    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  packages    SubscriptionPackageFeature[]
  offers      VendorSubscriptionOffer[]
  usage       VendorFeatureUsage[]

  @@index([isActive, sortOrder])
  @@map("subscription_features")
}

/// A subscription plan ("Smart", "Business"…). Named Package to avoid the legacy SubscriptionPlan enum.
model SubscriptionPackage {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  description  String?
  icon         String?
  color        String?
  displayOrder Int                  @default(0)
  status       SubPackageStatus     @default(DRAFT)
  visibility   SubPackageVisibility @default(PUBLIC)
  isPopular    Boolean              @default(false)
  /// Free trial length offered on first subscription (null = none).
  trialDays    Int?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  features     SubscriptionPackageFeature[]
  prices       SubscriptionPackagePrice[]
  subscribers  VendorSubscription[] @relation("CurrentPackage")
  offers       VendorSubscriptionOffer[] @relation("OfferPackage")
  payments     SubscriptionPayment[]

  @@index([status, displayOrder])
  @@map("subscription_packages")
}

/// What a plan includes: feature on/off plus limit values (null = unlimited).
model SubscriptionPackageFeature {
  id        String              @id @default(cuid())
  packageId String
  featureId String
  enabled   Boolean             @default(true)
  /// { [limitKey]: number | boolean | null } — null means unlimited.
  config    Json                @default("{}")
  package   SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature   SubscriptionFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([packageId, featureId])
  @@map("subscription_package_features")
}

/// Admin-defined billing durations (Monthly = 1, Half-Yearly = 6, Yearly = 12, custom…).
model SubscriptionCycle {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  months     Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  prices     SubscriptionPackagePrice[]
  subscriptions VendorSubscription[]
  offers     VendorSubscriptionOffer[]
  payments   SubscriptionPayment[]

  @@map("subscription_cycles")
}

/// A plan's price for one cycle. A plan needn't offer every cycle.
model SubscriptionPackagePrice {
  id              String              @id @default(cuid())
  packageId       String
  cycleId         String
  price           Decimal             @db.Decimal(18, 2)
  promoPrice      Decimal?            @db.Decimal(18, 2)
  discountPercent Decimal?            @db.Decimal(5, 2)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  package         SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  cycle           SubscriptionCycle   @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@unique([packageId, cycleId])
  @@map("subscription_package_prices")
}

/// Immutable history of a vendor's plan subscription (every admin or payment change).
model VendorSubscriptionEvent {
  id             String             @id @default(cuid())
  subscriptionId String
  vendorId       String
  kind           String
  before         Json?
  after          Json?
  paymentId      String?
  offerId        String?
  actorUserId    String?
  reason         String?
  createdAt      DateTime           @default(now())
  subscription   VendorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([vendorId, createdAt])
  @@map("vendor_subscription_events")
}

/// A vendor-specific offer. Never affects other vendors; never charges anyone by itself.
model VendorSubscriptionOffer {
  id                   String               @id @default(cuid())
  vendorId             String
  kind                 SubOfferKind
  packageId            String?
  cycleId              String?
  featureId            String?
  /// PRICE_OVERRIDE: the price; PERCENT_DISCOUNT: 0–100; FIXED_DISCOUNT: ৳ off.
  value                Decimal?             @db.Decimal(18, 2)
  startsAt             DateTime
  endsAt               DateTime
  status               SubOfferStatus       @default(ACTIVE)
  afterExpiry          SubOfferAfterExpiry  @default(MANUAL_RENEWAL)
  afterExpiryPackageId String?
  note                 String?
  createdById          String
  updatedById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  vendor               Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  package              SubscriptionPackage? @relation("OfferPackage", fields: [packageId], references: [id], onDelete: Restrict)
  cycle                SubscriptionCycle?   @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  feature              SubscriptionFeature? @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@index([vendorId, status, endsAt])
  @@index([status, endsAt])
  @@map("vendor_subscription_offers")
}

/// A subscription payment (v1: admin-verified manual payments). Separate from vendor earnings.
model SubscriptionPayment {
  id             String              @id @default(cuid())
  vendorId       String
  packageId      String
  cycleId        String
  amount         Decimal             @db.Decimal(18, 2)
  /// The regular price at the time, for discount reporting.
  listAmount     Decimal             @db.Decimal(18, 2)
  currency       String              @default("BDT")
  status         SubPaymentStatus    @default(PENDING)
  method         String
  reference      String?
  offerId        String?
  idempotencyKey String              @unique
  periodStart    DateTime?
  periodEnd      DateTime?
  recordedById   String?
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  package        SubscriptionPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  cycle          SubscriptionCycle   @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@index([vendorId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_payments")
}

/// Usage counters for limited features, per period ("YYYY-MM" or "ALL").
model VendorFeatureUsage {
  id        String              @id @default(cuid())
  vendorId  String
  featureId String
  limitKey  String
  periodKey String
  used      Int                 @default(0)
  updatedAt DateTime            @updatedAt
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  feature   SubscriptionFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([vendorId, featureId, limitKey, periodKey])
  @@map("vendor_feature_usage")
}

// ═══════════════════════════════════════════════════════════════════════════
// Vendor payout scheduling (2026-11). Balances stay in VendorPayable (ledger-
// derived); these tables only schedule, approve and record payouts. Marking a
// payout item paid posts the ledger voucher, which is what reduces VendorPayable.
// ═══════════════════════════════════════════════════════════════════════════

enum PayoutCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum PayoutBatchStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PayoutItemStatus {
  PENDING
  APPROVED
  PAID
  HELD
  CANCELLED
}

/// Vendor-specific payout rule; any null field falls back to the default policy (platform_settings).
model VendorPayoutRule {
  vendorId            String       @id
  cycle               PayoutCycle?
  /// WEEKLY / BIWEEKLY: 0 = Sunday … 6 = Saturday.
  weekday             Int?
  /// MONTHLY / QUARTERLY / CUSTOM day-of-month rules, e.g. [1, 15].
  monthDays           Int[]        @default([])
  customIntervalDays  Int?
  anchorDate          DateTime?
  minThreshold        Decimal?     @db.Decimal(18, 2)
  settlementDelayDays Int?
  requireApproval     Boolean?
  paused              Boolean      @default(false)
  holdUntil           DateTime?
  holdReason          String?
  note                String?
  updatedById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  vendor              Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@map("vendor_payout_rules")
}

model PayoutBatch {
  id           String            @id @default(cuid())
  batchNumber  String            @unique
  scheduledFor DateTime
  status       PayoutBatchStatus @default(DRAFT)
  totalAmount  Decimal           @default(0) @db.Decimal(18, 2)
  vendorCount  Int               @default(0)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        PayoutBatchItem[]

  @@index([status, scheduledFor])
  @@map("payout_batches")
}

model PayoutBatchItem {
  id             String           @id @default(cuid())
  batchId        String
  vendorId       String
  /// Eligible amount computed from the ledger when the batch was built.
  amount         Decimal          @db.Decimal(18, 2)
  status         PayoutItemStatus @default(PENDING)
  /// Snapshot of how the amount was computed (balance, delay window, open items, rule).
  calculation    Json
  method         String?
  reference      String?
  voucherId      String?
  paidAt         DateTime?
  paidById       String?
  heldReason     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  batch          PayoutBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  vendor         Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([batchId, vendorId])
  @@index([vendorId, status])
  @@map("payout_batch_items")
}

/// Append-only audit of payout settings, rules, batches and items.
model PayoutAuditLog {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  action      String
  before      Json?
  after       Json?
  actorUserId String?
  actorName   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@map("payout_audit_logs")
}
