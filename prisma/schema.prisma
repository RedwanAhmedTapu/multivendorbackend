// ============================================================
// FRAUD CHECKER PROVIDER — merge these models into your main
// schema.prisma, then run:
//   npx prisma migrate dev --name add_fraud_checker_providers
//
// NOTE: createdBy relates to your existing "User" model (admins are
// User rows with role = ADMIN, same pattern as TermsAndConditions.
// createdBy in your schema) — not "Employee", which is a separate
// staff/POS model. Also add this one line inside your existing User
// model so Prisma's reverse relation resolves:
//
//   createdFraudProviders FraudCheckerProvider[] @relation("FraudProviderCreator")
// ============================================================

// One row per fraud-checker integration (Nirvor, FraudBD, Mr Fraud
// Checker, FraudShield BD, etc.). Admin adds/edits/toggles these from
// the admin panel — no deploy needed to swap providers.
model FraudCheckerProvider {
  id        String  @id @default(cuid())

  // Must match a key registered in providers/registry.ts (e.g. "nirvor",
  // "fraudbd"). This is how the code knows *which adapter* to run for
  // this row's credentials — the row itself never contains request logic.
  slug      String  @unique

  // Shown in the admin UI.
  name      String

  // Optional override of the provider's default base URL (useful for
  // sandbox/staging keys without touching code).
  baseUrl   String?

  // Only ACTIVE providers are used at runtime. Admin can flip this off
  // instantly to pull a provider out of rotation (e.g. it's down, or the
  // bill wasn't paid) without deleting the config.
  isActive  Boolean @default(false)

  // Lower number = tried first. Lets admin set a primary provider with
  // others as fallback, or run several in parallel (service decides).
  priority  Int     @default(0)

  // Whether a failed call to this provider should fall back to the next
  // one in priority order, or be treated as a hard failure.
  fallbackOnError Boolean @default(true)

  // === SECURITY-CRITICAL FIELD ===
  // Never store raw API keys/secrets here. This holds the OUTPUT of
  // encryptCredentials() from src/lib/crypto/credential-cipher.ts —
  // format "v1:<iv_b64>:<authTag_b64>:<ciphertext_b64>". Decrypted only
  // in-memory, only inside FraudCheckerService, only for the duration of
  // one request.
  credentialsEncrypted String

  // Non-secret settings: timeoutMs, custom headers, etc. Safe to show
  // in the admin UI as-is.
  configJson Json?

  // Optional FK to the admin who created this row. Admins are User rows
  // with role = ADMIN — see note above.
  createdById String?
  createdBy   User? @relation("FraudProviderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs FraudCheckLog[]

  @@index([isActive, priority])
}

// Audit trail of every fraud-check call — which provider answered, how
// long it took, whether it errored. Useful for admin dashboards and for
// deciding whether to demote a flaky provider's priority.
model FraudCheckLog {
  id         String   @id @default(cuid())
  providerId String
  provider   FraudCheckerProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  phone        String
  success      Boolean
  riskLevel    String?  // "low" | "medium" | "high" | "very_high" | "unknown"
  responseJson Json?
  errorMessage String?
  latencyMs    Int?

  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([providerId, createdAt])
}
model CourierCredential {
  id                String           @id @default(cuid())
