model Payment {
  id               String                 @id @default(cuid())
  orderId          String
  amount           Decimal                @db.Decimal(18, 4)
  status           PaymentStatus          @default(PENDING)
  meta             Json?
  createdAt        DateTime               @default(now())
  paidAt           DateTime?
  method           PaymentMethod
  // Which admin-configured gateway (SSLCommerz, EPS, ...) actually
  // processed THIS payment. Nullable so existing SSLCommerz-only rows
  // don't need a backfill. Callbacks (IPN/success/fail) must verify
  // against THIS field, not "whichever gateway is active right now" —
  // an admin could switch the active gateway while a payment is in
  // flight, and the callback still has to be checked against the
  // gateway that actually issued it.
  paymentProviderId String?
  paymentProvider  PaymentProvider?       @relation(fields: [paymentProviderId], references: [id])
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sslCommerzDetail SSLCommerzTransaction?

  @@index([orderId])
  @@index([method, status])
  @@index([paymentProviderId])
  @@map("payments")
}

// ===========================================================
// Admin-configurable payment gateways (SSLCommerz, EPS, ...).
// Mirrors the CourierProviders/CourierCredential pattern used for
// Pathao/RedX/Steadfast: an admin can register multiple gateways but
// only ONE is `isActive` at a time — that's the one initiatePayment()
// uses and the one the storefront checkout UI should display.
// ===========================================================
model PaymentProvider {
  id                String            @id
  name              String            @unique
  slug              String            @unique
  displayName       String?
  description       String?
  logo              String?
  isActive          Boolean           @default(false)
  sandboxBaseUrl    String?
  productionBaseUrl String
  authType          PaymentAuthType
  priority          Int               @default(100)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payment_credentials PaymentCredential[]
  payments          Payment[]

  @@index([isActive])
  @@map("payment_providers")
}

model PaymentCredential {
  id                String          @id @default(cuid())
  paymentProviderId String
  environment       Environment     @default(PRODUCTION)
  // SSLCommerz: storeId/storePassword. EPS: merchantId + storeId (both
  // merchant-level constants from the EPS portal), username/password +
  // hashKey (the shared secret used to compute the x-hash HMAC-SHA512
  // header), and a cached accessToken/tokenExpiresAt from EPS's GetToken
  // API (same short-lived-bearer-token pattern as Pathao's OAuth2 creds).
  storeId           String?
  merchantId        String?   // NEW — EPS-specific, required by InitializeEPS
  storePassword     String?
  username          String?
  password          String?
  hashKey           String?
  accessToken       String?
  tokenExpiresAt    DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  payment_provider  PaymentProvider @relation(fields: [paymentProviderId], references: [id], onDelete: Cascade)

  @@unique([paymentProviderId, environment])
  @@map("payment_credentials")
}

enum PaymentAuthType {
  BASIC // static store_id/store_password sent on every request (SSLCommerz)
  TOKEN // username/password exchanged for a short-lived bearer token (EPS)
}

