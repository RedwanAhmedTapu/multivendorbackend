/// Warehouse-specific courier pickup configuration (Pathao store / RedX pickup
/// store), keyed by warehouse + courier credential — a provider store id only
/// exists inside one merchant account + environment, which is exactly what a
/// CourierCredential represents. The source of truth for courier pickup in
/// quote and booking. Provider ids here are PROVIDER data; they never replace
/// FinixMart's internal locations.id.
///
/// Integrity (enforced in the database):
///   - (warehouseId, vendorId)              → VendorWarehouse(id, vendorId)
///   - (courierCredentialId, courierProviderId) → CourierCredential(id, courierProviderId)
///   - partial UNIQUE (warehouseId, courierCredentialId) WHERE status = 'ACTIVE'
///   - partial UNIQUE (courierCredentialId, providerStoreId)
///       WHERE status IN ('ACTIVE','PENDING_APPROVAL') AND providerStoreId IS NOT NULL
///   (the partial indexes are raw SQL in migration 20261008010000 — Prisma
///    cannot express them.)
/// Credential scope (credential.vendorId IS NULL OR = warehouse.vendorId) is
/// enforced in warehouse-courier-pickup.service.ts.
/// A linked providerStoreId is immutable: replacing a store = old row INACTIVE,
/// new row ACTIVE.
model WarehouseCourierPickup {
  id                  String                       @id @default(cuid())
  warehouseId         String
  vendorId            String
  courierCredentialId String
  courierProviderId   String
  /// Pathao store_id / RedX pickup_store id. Nullable only to keep the model
  /// open for providers without a store concept; required for Pathao/RedX.
  providerStoreId     String?
  providerStoreName   String?
  providerCityId      String?
  providerZoneId      String?
  /// Pathao store area_id / RedX pickup store area_id (RedX quote pickup_area_id).
  providerAreaId      String?
  status              WarehouseCourierPickupStatus @default(PENDING_APPROVAL)
  rawData             Json?
  lastVerifiedAt      DateTime?
  createdById         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  warehouse           VendorWarehouse              @relation(fields: [warehouseId, vendorId], references: [id, vendorId], onDelete: Cascade)
  courierCredential   CourierCredential            @relation(fields: [courierCredentialId, courierProviderId], references: [id, courierProviderId], onDelete: Cascade, map: "warehouse_courier_pickups_credential_provider_fkey")

  @@index([warehouseId, courierCredentialId, status], map: "warehouse_courier_pickups_wh_cred_status_idx")
  @@index([courierCredentialId, providerStoreId], map: "warehouse_courier_pickups_cred_store_idx")
  @@index([vendorId])
  @@map("warehouse_courier_pickups")
}

