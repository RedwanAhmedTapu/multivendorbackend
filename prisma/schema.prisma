// ═══════════════════════════════════════════════════════════════════════════
// Theme management (Part 2 — THEME_MANAGEMENT_ARCHITECTURE.md §2.3).
// Semantic color palettes with publish history and per-scope assignments.
// Additive only; the layout-switcher `Theme` model above is untouched.
// Audit-trail ids (createdById / publishedById / updatedById) are plain
// strings with no FK so history survives user deletion. `scopeId` is a plain
// string for the same reason ("" = global, otherwise a vendor id).
// ═══════════════════════════════════════════════════════════════════════════

enum PaletteKind {
  PRESET
  CUSTOM
}

enum PaletteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

