generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model User {
  id                       String                    @id @default(cuid())
  name                     String?
  email                    String?                   @unique
  phone                    String?                   @unique
  password                 String
  role                     UserRole
  isActive                 Boolean                   @default(true)
  isVerified               Boolean                   @default(false)
  provider                 String?
  providerId               String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  vendorId                 String?                   @unique
  auditLogs                AuditLog[]
  blogPosts                BlogPost[]
  carts                    carts?
  conversationParticipants ConversationParticipant[]
  customerProfile          CustomerProfile?
  createdEmployees         Employee[]                @relation("EmployeeCreator")
  employee                 Employee?
  createdFraudProviders    FraudCheckerProvider[]     @relation("FraudProviderCreator")  
  loginHistory             LoginHistory[]
  loyaltyTransactions      LoyaltyTransaction[]
  sentMessages             Message[]
  notificationSetting      NotificationSetting?
  offerUsages              OfferUsage[]              @relation("OfferUsages")
  targetedOffers           OfferUser[]
  createdOffers            Offer[]                   @relation("OfferCreatedByUser")
  orders                   Order[]
  approvedProducts         Product[]                 @relation("ProductApprover")
  recentlyViewedProducts   RecentlyViewedProduct[]
  reviews                  Review[]
  reviewComments           ReviewComment[]
  assignedTickets          SupportTicket[]           @relation("AssignedTickets")
  tickets                  SupportTicket[]           @relation("UserTickets")
  createdTerms             TermsAndConditions[]      @relation("TermsCreator")
  updatedTerms             TermsAndConditions[]      @relation("TermsUpdater")
  ticketMessages           TicketMessage[]           @relation("TicketMessages")
  userAddresses            UserAddress[]
  vendor                   Vendor?                   @relation("UserVendor", fields: [vendorId], references: [id])
  followedVendors          VendorFollower[]          @relation("UserFollowedVendors")
  setProductFieldRules     VendorProductFieldRule[]  @relation("ProductFieldRuleSetBy")
  vouchersAsCustomer       Voucher[]                 @relation("VoucherCustomer")
  walletTransactions       WalletTransaction[]
  webauthnCredentials      WebAuthnCredential[]
  wishlists                wishlists?
  promotionRedemptions PromotionRedemption[]

  emailSmsRecipients EmailSmsCampaignRecipient[]

  @@map("users")
}

model LoginHistory {
  id              String      @id @default(cuid())
  userId          String?
  success         Boolean
  method          LoginMethod @default(PASSWORD)
  failureReason   String?
  attemptedEmail  String?
  attemptedPhone  String?
  ipAddress       String      @default("unknown")
  device          String      @default("desktop")
  deviceName      String      @default("Unknown Device")
  browser         String      @default("Unknown")
  os              String      @default("Unknown")
  platform        String?
  platformVersion String?
  model           String?
  loginAt         DateTime    @default(now())
  createdAt       DateTime    @default(now())
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@map("login_history")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id        String                   @id @default(cuid())
  challenge String                   @unique
  userId    String?
  purpose   WebAuthnChallengePurpose
  createdAt DateTime                 @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model Supplier {
  id              String          @id @default(cuid())
  name            String
  supplierType    SupplierType
  status          SupplierStatus  @default(ACTIVE)
  contactName     String?
  phone           String
  phone2          String?
  email           String
  country         String?
  city            String?
  zipCode         String?
  fullAddress     String?
  paymentTerms    String?
  creditLimit     Float           @default(0)
  bankAccountName String?
  bankAccountNo   String?
  bankName        String?
  bankBranch      String?
  routingNo       String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  coaAccountId    String?         @unique
  purchaseOrders  PurchaseOrder[]
  coaAccount      ChartOfAccount? @relation("SupplierCOA", fields: [coaAccountId], references: [id])

  @@map("suppliers")
}

model PurchaseOrder {
  id                String                       @id @default(cuid())
  purchaseNo        String                       @unique
  supplierId        String
  warehouseId       String?
  supplierInvoiceNo String?
  purchaseDate      DateTime
  subtotal          Decimal                      @db.Decimal(18, 4)
  vatAmount         Decimal                      @db.Decimal(18, 4)
  totalAmount       Decimal                      @db.Decimal(18, 4)
  paidAmount        Decimal                      @db.Decimal(18, 4)
  dueAmount         Decimal                      @db.Decimal(18, 4)
  notes             String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  receivingStatus   PurchaseOrderReceivingStatus @default(DRAFT)
  paymentStatus     PurchaseOrderPaymentStatus   @default(UNPAID)
  cancelReason      String?
  cancelledAt       DateTime?
  cancelledBy       String?
  shortCloseReason  String?
  shortClosedAt     DateTime?
  shortClosedBy     String?
  items             PurchaseOrderItem[]
  supplier          Supplier                     @relation(fields: [supplierId], references: [id])
  warehouse         VendorWarehouse?             @relation(fields: [warehouseId], references: [id])
  payments          PurchasePayment[]
  receives          PurchaseReceive[]
  refunds           PurchaseRefund[]
  returns           PurchaseReturn[]

  @@index([supplierId])
  @@index([receivingStatus])
  @@index([paymentStatus])
  @@index([warehouseId])
  @@index([purchaseDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String                @id @default(cuid())
  purchaseOrderId   String
  variantId         String
  productName       String
  variantName       String
  sku               String
  quantity          Int
  receivedQuantity  Int                   @default(0)
  unitCost          Decimal               @db.Decimal(18, 4)
  total             Decimal               @db.Decimal(18, 4)
  newAvgCost        Decimal               @db.Decimal(18, 4)
  sellPrice         Decimal               @db.Decimal(18, 4)
  expiryDate        DateTime?
  createdAt         DateTime              @default(now())
  mrpPrice          Decimal?              @db.Decimal(18, 4)
  cancelledQuantity Int                   @default(0)
  purchaseOrder     PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant           ProductVariant        @relation(fields: [variantId], references: [id])
  receiveItems      PurchaseReceiveItem[]
  returnItems       PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model PurchaseReceive {
  id              String                @id @default(cuid())
  purchaseOrderId String
  receiveNo       String                @unique
  receivedAt      DateTime              @default(now())
  receivedBy      String?
  notes           String?
  voucherId       String?
  createdAt       DateTime              @default(now())
  items           PurchaseReceiveItem[]
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  voucher         Voucher?              @relation("ReceiveVoucher", fields: [voucherId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_receives")
}

model PurchaseReceiveItem {
  id                  String            @id @default(cuid())
  purchaseReceiveId   String
  purchaseOrderItemId String
  quantity            Int
  warehouseId         String
  rackId              String?
  rowNumber           Int?
  shelfNumber         Int?
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseReceive     PurchaseReceive   @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  rack                WarehouseRack?    @relation(fields: [rackId], references: [id])
  warehouse           VendorWarehouse   @relation(fields: [warehouseId], references: [id])

  @@index([purchaseReceiveId])
  @@index([purchaseOrderItemId])
  @@index([warehouseId])
  @@index([rackId])
  @@map("purchase_receive_items")
}

model PurchaseReturn {
  id              String               @id @default(cuid())
  purchaseOrderId String
  returnNo        String               @unique
  reason          String?
  returnAmount    Decimal              @db.Decimal(18, 4)
  voucherId       String?
  createdAt       DateTime             @default(now())
  createdBy       String?
  items           PurchaseReturnItem[]
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  voucher         Voucher?             @relation("PurchaseReturnVoucher", fields: [voucherId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                  String            @id @default(cuid())
  purchaseReturnId    String
  purchaseOrderItemId String
  quantity            Int
  unitCost            Decimal           @db.Decimal(18, 4)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseReturn      PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

model PurchaseRefund {
  id              String        @id @default(cuid())
  purchaseOrderId String
  refundNo        String        @unique
  amount          Decimal       @db.Decimal(18, 4)
  bankCoaId       String?
  reference       String?
  voucherId       String?
  createdAt       DateTime      @default(now())
  vendorPaymentAccountId String?
  vendorPaymentAccount   VendorPaymentAccount?  @relation(fields: [vendorPaymentAccountId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  voucher         Voucher?      @relation("PurchaseRefundVoucher", fields: [voucherId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_refunds")
}

model PurchasePayment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  amount          Decimal       @db.Decimal(18, 4)
  method          String
  coaAccountId    String?
  reference       String?
  paidAt          DateTime      @default(now())
  voucherId       String?
  receiptNo       String?       @unique
 vendorPaymentAccountId String?
  vendorPaymentAccount   VendorPaymentAccount?  @relation(fields: [vendorPaymentAccountId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  voucher         Voucher?      @relation("PaymentVoucher", fields: [voucherId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_payments")
}

model VoucherSequence {
  id          String      @id @default(cuid())
  voucherType VoucherType
  yearMonth   String
  lastNumber  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([voucherType, yearMonth])
  @@map("voucher_sequences")
}

model Vendor {
  id                       String                     @id @default(cuid())
  storeName                String
  avatar                   String?
  email                    String?
  status                   VendorStatus               @default(PENDING)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  currentCommissionRate    Float?                     @default(0)
  accountType              AccountType                @default(INDIVIDUAL)
  businessType             BusinessType?
  verificationStatus       VerificationStatus         @default(PENDING)
  verifiedAt               DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  brands                   Brand[]
  catalogRequests          CatalogRequest[]
  sliders                  Slider[]                   @relation("VendorSliders")
  storageFiles             StorageFile[]
  folders                  VendorFolder[]
  autoReplies              AutoReply[]                @relation("VendorAutoReplies")
  conversationParticipants ConversationParticipant[]  @relation("VendorParticipants")
  courier_credentials      CourierCredential[]
  courier_orders           CourierOrder[]
  courier_pricing_rules    CourierPricingRules[]
  employees                Employee[]                 @relation("VendorEmployees")
  sentMessages             Message[]                  @relation("VendorSentMessages")
  notificationSetting      NotificationSetting?       @relation("VendorNotificationSettings")
  offerPermissions         OfferPermission?
  targetedByOffers         OfferVendor[]              @relation("TargetedOffers")
  createdOffers            Offer[]                    @relation("OfferCreatedByVendor")
  posBankAccounts          PosBankAccount[]
  posCustomers             PosCustomer[]
  posSales                 PosSale[]
  posSettings              PosSettings?
  posStaff                 PosStaff[]
  posSubscription          PosSubscription?
  posTrialGrant            PosTrialGrant?
  posSubscriptionPayments  PosSubscriptionPayment[]
  hrBranches               HrBranch[]
  hrDepartments            HrDepartment[]
  hrDesignations           HrDesignation[]
  products                 Product[]
  quickReplies             QuickReply[]               @relation("VendorQuickReplies")
  bannerCustomization      StoreBannerCustomization?  @relation("VendorBannerCustomization")
  decorations              StoreDecoration[]          @relation("VendorDecorations")
  user                     User?                      @relation("UserVendor")
  pickupAddress            VendorAddress?
  paymentAccounts          VendorPaymentAccount[]
  commissions              VendorCommission[]
  agentLinks               AgentVendorLink[]          @relation("VendorAgentLinks")
  agentOverrides           AgentCommissionOverride[]  @relation("VendorAgentOverrides")
  documents                VendorDocument[]
  flags                    VendorFlag[]
  followers                VendorFollower[]           @relation("VendorFollowers")
  messagingSettings        VendorMessagingSetting?
  monthlyCharges           VendorMonthlyCharge[]
  onboarding               VendorOnboardingChecklist?
  orders                   VendorOrder[]
  payouts                  VendorPayout[]
  performance              VendorPerformance?
  personalInfo             VendorPersonalInfo?
  productFieldRules        VendorProductFieldRule[]
  settings                 VendorSettings?
  storageCharges           VendorStorageCharge[]
  storageUsage             VendorStorageUsage?
  subscription             VendorSubscription?
  subscriptionOffers       VendorSubscriptionOffer[]
  subscriptionPayments     SubscriptionPayment[]
  featureUsage             VendorFeatureUsage[]
  payoutRule               VendorPayoutRule?
  payoutItems              PayoutBatchItem[]
  warehouses               VendorWarehouse[]
  vouchersAsVendor         Voucher[]                  @relation("VoucherVendor")

    returns              VendorReturn[]
  marketingCampaignInvites MarketingCampaignInvite[]
  campaignRegistrations    CampaignRegistration[]
  flashSaleItems           FlashSaleItem[]
  promotions               Promotion[]
  coinsSetting             VendorCoinsSetting?
  coinsSettingHistory      VendorCoinsSettingHistory[]
  adWallet                 VendorAdWallet?
  adWalletTxns             VendorAdWalletTxn[]
  adTopupPayments          AdTopupPayment[]
  adCampaigns              AdCampaign[]
  adClicks                 AdClick[]
  orderItemDiscounts       OrderItemDiscount[]

  @@map("vendors")
}

model VendorPersonalInfo {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  idNumber      String?
  idName        String?
  companyName   String?
  businessRegNo String?
  taxIdNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_personal_info")
}

model VendorAddress {
  id             String   @id @default(cuid())
  vendorId       String   @unique
  detailsAddress String?
  city           String?
  zone           String?
  area           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_addresses")
}

model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  swiftCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  BankBranch[]

  @@map("banks")
}

model BankBranch {
  id            String   @id @default(cuid())
  bankId        String
  branchName    String
  routingNumber String?  @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bank               Bank               @relation(fields: [bankId], references: [id], onDelete: Cascade)
  vendorAccounts VendorPaymentAccount[]
  adminAccounts  AdminPaymentAccount[]

  @@unique([bankId, branchName])
  @@index([bankId])
  @@map("bank_branches")
}

model VendorPaymentAccount {
  id               String                 @id @default(cuid())
  vendorId         String
  type             PaymentInstrumentType

  // ── BANK এর জন্য ──
  bankBranchId     String?
  accountName      String?
  accountNumber    String?

  // ── MOBILE_BANKING এর জন্য ──
  mobileProvider   MobileBankingProvider?
  walletNumber     String?
  walletKind       String?   // "Personal" | "Merchant" | "Agent"

  // ── CARD এর জন্য ──
  cardProcessor    String?   // e.g. "SSLCommerz POS", "Fortis Terminal"
  merchantId       String?

  // ── shared ──
  label            String?   // vendor নিজে নাম দিতে পারবে, e.g. "Shop-1 Bkash"
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  chartOfAccountId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor           Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bankBranch       BankBranch?     @relation(fields: [bankBranchId], references: [id])
  chartOfAccount   ChartOfAccount? @relation("VendorPaymentAccountCOA", fields: [chartOfAccountId], references: [id])
  purchasePayments PurchasePayment[]
  purchaseRefunds  PurchaseRefund[]

  @@unique([vendorId, bankBranchId, accountNumber])
  @@unique([vendorId, mobileProvider, walletNumber])
  @@index([vendorId, type, isActive])
  @@index([vendorId, isDefault])
  @@map("vendor_payment_accounts")
}

model AdminPaymentAccount {
  id               String                 @id @default(cuid())
  type             PaymentInstrumentType  // BANK / MOBILE_BANKING / CARD / CASH

  // BANK
  bankBranchId     String?
  accountName      String?
  accountNumber    String?

  // MOBILE_BANKING (e.g. admin disburses payout via Bkash merchant)
  mobileProvider   MobileBankingProvider?
  walletNumber     String?
  // ── CARD এর জন্য ──
  cardProcessor    String?   // e.g. "SSLCommerz POS", "Fortis Terminal"
  merchantId       String?

  // shared
  label            String?
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  chartOfAccountId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bankBranch       BankBranch?     @relation(fields: [bankBranchId], references: [id])
  chartOfAccount   ChartOfAccount? @relation("AdminPaymentAccountCOA", fields: [chartOfAccountId], references: [id])

  @@unique([bankBranchId, accountNumber])
  @@unique([mobileProvider, walletNumber])
  @@index([type, isActive])
  @@index([isDefault])
  @@map("admin_payment_accounts")
}

model VendorDocument {
  id                 String                     @id @default(cuid())
  vendorId           String
  type               DocumentType
  title              String
  filePath           String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  vendor             Vendor                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorSettings {
  id                 String   @id @default(cuid())
  vendorId           String   @unique
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_settings")
}

model VendorSubscription {
  id        String           @id @default(cuid())
  vendorId  String           @unique
  planType  SubscriptionPlan @default(FREE)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  /// Subscription platform (2026-11): the vendor's CURRENT dynamic plan. Legacy rows keep
  /// planType / isActive and have status = null (no plan entitlements).
  packageId         String?
  cycleId           String?
  status            VendorSubStatus?
  source            VendorSubSource?
  startedAt         DateTime?
  expiresAt         DateTime?
  graceDays         Int?
  autoRenew         Boolean          @default(false)
  amountPaid        Decimal?         @db.Decimal(18, 2)
  currency          String           @default("BDT")
  offerId           String?
  previousPackageId String?
  suspendedReason   String?
  cancelledAt       DateTime?
  reminderSentFor   DateTime?
  version           Int              @default(0)
  package           SubscriptionPackage?       @relation("CurrentPackage", fields: [packageId], references: [id], onDelete: Restrict)
  cycle             SubscriptionCycle?         @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  events            VendorSubscriptionEvent[]

  @@index([status, expiresAt])
  @@map("vendor_subscriptions")
}

model VendorOnboardingChecklist {
  id                   String   @id @default(cuid())
  vendorId             String   @unique
  personalInfoComplete Boolean  @default(false)
  addressComplete      Boolean  @default(false)
  bankInfoComplete     Boolean  @default(false)
  documentsComplete    Boolean  @default(false)
  overallComplete      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_onboarding_checklist")
}

model VendorCommission {
  id         String    @id @default(cuid())
  vendorId   String
  categoryId String?
  rate       Float
  createdAt  DateTime  @default(now())
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, categoryId])
  @@map("vendor_commissions")
}

model VendorPayout {
  id        String       @id @default(cuid())
  vendorId  String
  amount    Float
  status    PayoutStatus @default(PENDING)
  method    String?
  period    String?
  note      String?
  createdAt DateTime     @default(now())
  paidAt    DateTime?
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_payouts")
}

model VendorMonthlyCharge {
  id            String    @id @default(cuid())
  vendorId      String
  amount        Float
  description   String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_monthly_charges")
}

model VendorFlag {
  id        String   @id @default(cuid())
  vendorId  String
  reason    String
  severity  Int      @default(1)
  meta      Json?
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_flags")
}

model VendorPerformance {
  id                 String    @id @default(cuid())
  vendorId           String    @unique
  totalSales         Float     @default(0)
  totalOrders        Int       @default(0)
  fulfillmentRatePct Float     @default(100)
  avgRating          Float     @default(0)
  lastCalculatedAt   DateTime?
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_performance")
}

model VendorMessagingSetting {
  id          String   @id @default(cuid())
  vendorId    String   @unique
  isAvailable Boolean  @default(true)
  autoReply   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_messaging_settings")
}

model VendorFollower {
  id         String   @id @default(cuid())
  vendorId   String
  userId     String
  followedAt DateTime @default(now())
  user       User     @relation("UserFollowedVendors", fields: [userId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation("VendorFollowers", fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([vendorId])
  @@index([userId])
  @@map("vendor_followers")
}

model VendorStorageUsage {
  id                String    @id @default(cuid())
  vendorId          String    @unique
  totalUsedBytes    BigInt    @default(0)
  freeQuotaBytes    BigInt    @default(5368709120)
  paidQuotaBytes    BigInt    @default(0)
  totalQuotaBytes   BigInt    @default(5368709120)
  totalFiles        Int       @default(0)
  imageFiles        Int       @default(0)
  documentFiles     Int       @default(0)
  lastCalculatedAt  DateTime  @default(now())
  currentMonthUsage BigInt    @default(0)
  lastBilledAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_storage_usage")
}

model VendorStorageCharge {
  id              String    @id @default(cuid())
  vendorId        String
  billingPeriod   String
  usedBytes       BigInt
  chargeableBytes BigInt
  pricePerGB      Float
  totalCharge     Float
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, billingPeriod])
  @@map("vendor_storage_charges")
}

model Brand {
  id                 String            @id @default(cuid())
  vendorId           String
  name               String
  relationship       BrandRelationship
  authorizationStart DateTime
  authorizationEnd   DateTime?
  hasEndDate         Boolean           @default(false)
  authenticationDoc  String?
  status             BrandStatus       @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  links              BrandLink[]
  products           Product[]

  @@unique([vendorId, name])
}

model BrandCatalog {
  id        String   @id @default(cuid())
  name      String   @unique
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_catalog")
}

model BrandLink {
  id        String   @id @default(cuid())
  brandId   String
  type      LinkType
  title     String?
  url       String
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CatalogRequest {
  id            String             @id @default(cuid())
  vendorId      String
  requestType   CatalogRequestType
  categoryId    String?
  attributeId   String?
  requestedName String
  requestedType String?
  description   String?
  status        RequestStatus      @default(PENDING)
  adminNote     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  attribute     Attribute?         @relation(fields: [attributeId], references: [id])
  category      Category?          @relation(fields: [categoryId], references: [id])
  vendor        Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model StorageFile {
  id           String        @id @default(cuid())
  vendorId     String
  folderId     String?
  fileName     String
  fileKey      String        @unique
  fileSize     BigInt
  mimeType     String
  fileType     String
  productId    String?
  variantId    String?
  documentType String?
  r2Bucket     String
  r2Url        String
  r2ETag       String?
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  folder       VendorFolder? @relation(fields: [folderId], references: [id])
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([folderId])
}

model VendorFolder {
  id        String         @id @default(cuid())
  vendorId  String
  name      String
  parentId  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  files     StorageFile[]
  parent    VendorFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  VendorFolder[] @relation("FolderHierarchy")
  vendor    Vendor         @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([parentId])
}

model Employee {
  id                       String                    @id @default(cuid())
  designation              String?
  department               String?
  permissions              Json
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  userId                   String?                   @unique
  createdById              String?
  vendorId                 String?
  isActive                 Boolean                   @default(true)
  conversationParticipants ConversationParticipant[]
  createdBy                User?                     @relation("EmployeeCreator", fields: [createdById], references: [id])
  user                     User?                     @relation(fields: [userId], references: [id])
  vendor                   Vendor?                   @relation("VendorEmployees", fields: [vendorId], references: [id])
  sentMessages             Message[]
  notificationSetting      NotificationSetting?
  posStaff                 PosStaff?
  hrProfile HrEmployeeProfile?

  @@map("employees")
}
// ============================ ORGANIZATION ============================

model HrBranch {
  id             String   @id @default(cuid())
  vendorId       String?  // null = admin/platform-side branch; set = belongs to a marketplace Vendor
  code           String
  name           String
  type           String   @default("STORE") // STORE | OFFICE | WAREHOUSE | OTHER
  address        String?
  managerId      String?  // HrEmployeeProfile.id
  contact        String?
  operatingHours String?
  latitude       Float?
  longitude      Float?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor      Vendor?            @relation(fields: [vendorId], references: [id])
  employees   HrEmployeeProfile[] @relation("HrEmployeeBranch")
  departments HrDepartment[]

  @@unique([vendorId, code])
  @@index([vendorId])
  @@map("hr_branches")
}

model HrDepartment {
  id          String   @id @default(cuid())
  vendorId    String?
  code        String
  name        String
  nameBn      String?
  description String?
  branchId    String?
  headId      String?  // HrEmployeeProfile.id
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor      Vendor?             @relation(fields: [vendorId], references: [id])
  branch      HrBranch?           @relation(fields: [branchId], references: [id])
  employees   HrEmployeeProfile[] @relation("HrEmployeeDepartment")
  designations HrDesignation[]

  @@unique([vendorId, code])
  @@index([vendorId])
  @@map("hr_departments")
}

model HrDesignation {
  id           String   @id @default(cuid())
  vendorId     String?
  code         String
  name         String
  nameBn       String?
  departmentId String?
  grade        String?
  minSalary    Decimal? @db.Decimal(14, 2)
  maxSalary    Decimal? @db.Decimal(14, 2)
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor     Vendor?             @relation(fields: [vendorId], references: [id])
  department HrDepartment?       @relation(fields: [departmentId], references: [id])
  employees  HrEmployeeProfile[] @relation("HrEmployeeDesignation")

  @@unique([vendorId, code])
  @@index([vendorId])
  @@map("hr_designations")
}

model HrShift {
  id                 String   @id @default(cuid())
  vendorId           String?
  name               String
  type               String   @default("FIXED") // FIXED | ROTATIONAL
  startTime          String   // HH:MM
  endTime            String   // HH:MM
  graceMinutes       Int      @default(10)
  breakMinutes       Int      @default(60)
  minWorkingHours    Float    @default(8)
  otThresholdMinutes Int      @default(30)
  otMultiplier       Float    @default(1.5)
  weeklyOff          String   @default("FRIDAY") // comma list
  branchId           String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments HrShiftAssignment[]

  @@index([vendorId])
  @@map("hr_shifts")
}

model HrShiftAssignment {
  id         String    @id @default(cuid())
  vendorId   String?
  employeeId String
  shiftId    String
  fromDate   String
  toDate     String?
  note       String?
  createdBy  String?   // User.id
  createdAt  DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift    HrShift           @relation(fields: [shiftId], references: [id])

  @@index([vendorId, employeeId])
  @@map("hr_shift_assignments")
}

// ============================ EMPLOYEE MASTER ============================

/// The bridge model. One row per staff member who needs HR data —
/// created automatically right after your existing createAdminEmployee /
/// createVendorEmployee runs (see service snippet in the write-up).
model HrEmployeeProfile {
  id       String @id @default(cuid())

  // ── link back to YOUR existing identity models — this IS the identity ──
  linkedUserId     String  @unique          // Employee.userId / User.id (auth happens there)
  linkedEmployeeId String  @unique          // Employee.id (permissions JSON lives there)
  linkedVendorId   String?                  // Vendor.id — null = admin/platform staff
  linkedEmployee Employee @relation(fields: [linkedEmployeeId], references: [id], onDelete: Restrict)

  code           String   // EMP-0001
  photoUrl       String?
  fullName       String
  nameBn         String?
  fatherName     String?
  motherName     String?
  spouseName     String?
  dob            String?  // ISO date
  gender         String?
  bloodGroup     String?
  maritalStatus  String?
  nationality    String   @default("Bangladeshi")
  religion       String?
  mobile         String?
  altMobile      String?
  personalEmail  String?
  emergencyName     String?
  emergencyRelation String?
  emergencyMobile   String?
  presentAddress   String?
  permanentAddress String?
  division   String?
  district   String?
  city       String?
  postCode   String?

  // ── employment / org placement ──
  branchId           String?
  departmentId       String?
  designationId      String?
  reportingManagerId String?  // HrEmployeeProfile.id
  shiftId            String?
  workLocation       String?
  joiningDate        String?
  confirmationDate   String?
  probationMonths    Int      @default(3)
  employmentType     String   @default("PERMANENT") // PERMANENT | PROBATIONARY | CONTRACTUAL | TEMPORARY | PART_TIME | INTERN
  status             String   @default("ACTIVE")     // ACTIVE | PROBATION | ON_LEAVE | SUSPENDED | RESIGNED | TERMINATED | INACTIVE
  grade              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch      HrBranch?      @relation("HrEmployeeBranch", fields: [branchId], references: [id], onDelete: Restrict)
  department  HrDepartment?  @relation("HrEmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  designation HrDesignation? @relation("HrEmployeeDesignation", fields: [designationId], references: [id], onDelete: Restrict)
  manager       HrEmployeeProfile?  @relation("HrEmployeeManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports HrEmployeeProfile[] @relation("HrEmployeeManager")

  familyMembers       HrFamilyMember[]
  education           HrEducation[]
  documents           HrEmployeeDocument[]
  history             HrEmployeeHistory[]
  attendances         HrAttendance[]
  attendanceCorrections HrAttendanceCorrection[]
  leaveBalances       HrLeaveBalance[]
  leaveRequests       HrLeaveRequest[]
  shiftAssignments    HrShiftAssignment[]
  salaryStructures    HrSalaryStructure[]
  payrollEntries      HrPayrollEntry[]
  bonuses             HrBonus[]
  deductions          HrDeduction[]
  loans               HrLoan[]
  advances            HrAdvance[]
  expenseClaims       HrExpenseClaim[]
  kpiAssignments      HrKpiAssignment[]
  performanceReviews  HrPerformanceReview[]
  resignations        HrResignation[]
  hrLetters           HrLetter[]
  tasks               HrTask[]
  bankAccounts        HrEmployeeBankAccount[]
  previousEmployments HrPreviousEmployment[]
  promotions          HrPromotion[]
  transfers           HrTransfer[]
  salaryRevisions     HrSalaryRevision[]

  @@unique([linkedVendorId, code])
  @@index([linkedVendorId, status])
  @@index([linkedVendorId, branchId])
  @@index([linkedVendorId, departmentId])
  @@map("hr_employee_profiles")
}

model HrFamilyMember {
  id           String  @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  dob          String?
  occupation   String?
  mobile       String?
  dependent    Boolean @default(false)

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("hr_family_members")
}

model HrEducation {
  id          String  @id @default(cuid())
  employeeId  String
  degree      String
  institution String?
  major       String?
  passingYear String?
  result      String?

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("hr_education")
}

model HrEmployeeDocument {
  id               String    @id @default(cuid())
  vendorId         String?
  employeeId       String
  category         String    @default("IDENTITY") // IDENTITY | EDUCATION | EXPERIENCE | CONTRACT | OTHER
  docType          String    // NID | PASSPORT | BIRTH_REG | CERTIFICATE | AGREEMENT | APPOINTMENT | OTHER
  title            String
  docNumber        String?
  issueDate        String?
  expiryDate       String?
  status           String    @default("VALID") // VALID | EXPIRING | EXPIRED | REJECTED
  fileUrl          String?   // store on disk/S3, not base64 in DB
  notes            String?
  verified         Boolean   @default(false)
  verifiedBy       String?   // User.id
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@index([vendorId, expiryDate])
  @@map("hr_employee_documents")
}

/// Immutable audit trail of career events. (Your existing AuditLog model
/// covers generic "who changed what" for the whole app — this one is
/// specifically the employee's own visible timeline: joined, promoted,
/// leave taken, letter issued, etc. Keep both; they serve different UIs.)
model HrEmployeeHistory {
  id            String   @id @default(cuid())
  vendorId      String?
  employeeId    String
  eventType     String   // JOINED | PROMOTION | TRANSFER | SALARY_REVISION | STATUS_CHANGE | LEAVE | RESIGNATION | LETTER | WARNING | EXIT | REVIEW
  title         String
  description   String?
  effectiveDate String?
  amount        Decimal? @db.Decimal(14, 2)
  createdBy     String?  // User.id
  createdAt     DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId, createdAt])
  @@map("hr_employee_history")
}

model HrPromotion {
  id               String   @id @default(cuid())
  vendorId         String?
  employeeId       String
  oldDesignationId String?
  newDesignationId String?
  newBasicSalary   Decimal? @db.Decimal(14, 2)
  effectiveDate    String
  reason           String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy       String?  // User.id
  createdAt        DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@map("hr_promotions")
}

model HrTransfer {
  id               String   @id @default(cuid())
  vendorId         String?
  employeeId       String
  fromBranchId     String?
  toBranchId       String?
  fromDepartmentId String?
  toDepartmentId   String?
  effectiveDate    String
  reason           String?
  status           String   @default("PENDING")
  approvedBy       String?
  createdAt        DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@map("hr_transfers")
}

model HrSalaryRevision {
  id              String   @id @default(cuid())
  vendorId        String?
  employeeId      String
  previousSalary  Decimal  @db.Decimal(14, 2)
  newSalary       Decimal  @db.Decimal(14, 2)
  effectiveDate   String
  reason          String?
  status          String   @default("PENDING")
  approvedBy      String?
  createdAt       DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@map("hr_salary_revisions")
}

/// Employee salary disbursement account — bank transfer or mobile financial
/// service (bKash/Nagad/Rocket). Multiple accounts allowed; one is primary.
model HrEmployeeBankAccount {
  id            String   @id @default(cuid())
  vendorId      String?
  employeeId    String
  holderName    String?
  bank          String?
  branch        String?
  accountNumber String?
  routingNumber String?
  accountType   String   @default("SALARY") // SAVINGS | CURRENT | SALARY
  mfsProvider   String?  // BKASH | NAGAD | ROCKET | OTHER
  mfsNumber     String?
  paymentMethod String   @default("BANK") // BANK | MFS | CASH | OTHER
  isPrimary     Boolean  @default(false)
  verified      Boolean  @default(false)
  verifiedBy    String?  // User.id
  createdAt     DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@map("hr_employee_bank_accounts")
}

/// Employment history before joining — captured on the Employee 360 page.
model HrPreviousEmployment {
  id               String   @id @default(cuid())
  vendorId         String?
  employeeId       String
  company          String
  designation      String?
  department       String?
  joinDate         String?
  leaveDate        String?
  lastSalary       Decimal? @db.Decimal(14, 2)
  reasonForLeaving String?
  supervisor       String?
  contact          String?
  notes            String?
  createdAt        DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, employeeId])
  @@map("hr_previous_employments")
}

// ============================ ATTENDANCE ============================

model HrAttendance {
  id                String   @id @default(cuid())
  vendorId          String?
  employeeId        String
  date              String   // ISO date
  shiftId           String?
  checkIn           String?  // HH:MM
  checkOut          String?  // HH:MM
  workingMinutes    Int      @default(0)
  lateMinutes       Int      @default(0)
  overtimeMinutes   Int      @default(0)
  status            String   @default("ABSENT") // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY | WEEKLY_OFF | WFH
  source            String   @default("MANUAL")  // MANUAL | WEB | IMPORT (add BIOMETRIC/QR later if devices are added)
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([vendorId, employeeId, date])
  @@index([vendorId, date])
  @@map("hr_attendances")
}

model HrAttendanceCorrection {
  id           String    @id @default(cuid())
  vendorId     String?
  employeeId   String
  date         String
  requestedIn  String?
  requestedOut String?
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  actedBy      String?
  actedAt      DateTime?
  createdAt    DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@map("hr_attendance_corrections")
}

// ============================ LEAVE ============================

model HrLeaveType {
  id                String  @id @default(cuid())
  vendorId          String?
  code              String
  name              String
  paid              Boolean @default(true)
  defaultDays       Int     @default(10)
  carryForward      Boolean @default(false)
  maxCarryForward   Int     @default(0)
  encashmentAllowed Boolean @default(false)
  requiresAttachment Boolean @default(false)
  active            Boolean @default(true)

  balances HrLeaveBalance[]
  requests HrLeaveRequest[]

  @@unique([vendorId, code])
  @@map("hr_leave_types")
}

model HrLeaveBalance {
  id             String @id @default(cuid())
  vendorId       String?
  employeeId     String
  leaveTypeId    String
  year           Int
  entitled       Float  @default(0)
  used           Float  @default(0)
  pending        Float  @default(0)
  carriedForward Float  @default(0)

  employee  HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType HrLeaveType       @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([vendorId, year])
  @@map("hr_leave_balances")
}

model HrLeaveRequest {
  id                   String    @id @default(cuid())
  vendorId             String?
  employeeId           String
  leaveTypeId          String
  fromDate             String
  toDate               String
  days                 Float
  reason               String?
  halfDay              Boolean   @default(false)
  attachmentUrl        String?
  substituteEmployeeId String?
  contactNumber        String?
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | WITHDRAWN
  approvalRequestId    String?
  actedBy              String?
  actedAt              DateTime?
  createdAt            DateTime  @default(now())

  employee  HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType HrLeaveType       @relation(fields: [leaveTypeId], references: [id])

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_leave_requests")
}

// ============================ COMPENSATION & PAYROLL ============================

model HrSalaryStructure {
  id              String   @id @default(cuid())
  vendorId        String?
  employeeId      String
  effectiveFrom   String
  effectiveTo     String?  // null = current
  basic           Decimal  @default(0) @db.Decimal(14, 2)
  houseRent       Decimal  @default(0) @db.Decimal(14, 2)
  medical         Decimal  @default(0) @db.Decimal(14, 2)
  conveyance      Decimal  @default(0) @db.Decimal(14, 2)
  otherAllowance  Decimal  @default(0) @db.Decimal(14, 2)
  gross           Decimal  @default(0) @db.Decimal(14, 2)
  componentsJson  Json     @default("[]") // extra flexible components
  status          String   @default("ACTIVE") // ACTIVE | SUPERSEDED | TERMINATED
  createdBy       String?
  createdAt       DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([vendorId, employeeId])
  @@map("hr_salary_structures")
}

/// Reusable templates so admin/vendor doesn't type the same components
/// for every new hire — apply one to instantly create a HrSalaryStructure.
model HrSalaryTemplate {
  id             String   @id @default(cuid())
  vendorId       String?
  name           String
  basic          Decimal  @default(0) @db.Decimal(14, 2)
  houseRent      Decimal  @default(0) @db.Decimal(14, 2)
  medical        Decimal  @default(0) @db.Decimal(14, 2)
  conveyance     Decimal  @default(0) @db.Decimal(14, 2)
  otherAllowance Decimal  @default(0) @db.Decimal(14, 2)
  componentsJson Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([vendorId])
  @@map("hr_salary_templates")
}

model HrPayrollRun {
  id             String   @id @default(cuid())
  vendorId       String?
  periodMonth    Int
  periodYear     Int
  frequency      String   @default("MONTHLY")
  cutoffDate     String?
  paymentDate    String?
  status         String   @default("DRAFT") // DRAFT | CALCULATED | REVIEW | APPROVED | PROCESSING | PAID | CANCELLED
  totalGross     Decimal  @default(0) @db.Decimal(14, 2)
  totalBonus     Decimal  @default(0) @db.Decimal(14, 2)
  totalDeduction Decimal  @default(0) @db.Decimal(14, 2)
  totalNet       Decimal  @default(0) @db.Decimal(14, 2)
  employeeCount  Int      @default(0)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries HrPayrollEntry[]

  @@unique([vendorId, periodYear, periodMonth])
  @@index([vendorId, status])
  @@map("hr_payroll_runs")
}

model HrPayrollEntry {
  id               String   @id @default(cuid())
  vendorId         String?
  runId            String
  employeeId       String
  presentDays      Float    @default(0)
  absentDays       Float    @default(0)
  leaveDays        Float    @default(0)
  otMinutes        Int      @default(0)
  gross            Decimal  @default(0) @db.Decimal(14, 2)
  otAmount         Decimal  @default(0) @db.Decimal(14, 2)
  bonus            Decimal  @default(0) @db.Decimal(14, 2)
  absenceDeduction Decimal  @default(0) @db.Decimal(14, 2)
  loanDeduction    Decimal  @default(0) @db.Decimal(14, 2)
  advanceDeduction Decimal  @default(0) @db.Decimal(14, 2)
  otherDeduction   Decimal  @default(0) @db.Decimal(14, 2)
  net              Decimal  @default(0) @db.Decimal(14, 2)
  breakdownJson    Json     @default("{}")
  payslipNumber    String?
  status           String   @default("INCLUDED") // INCLUDED | EXCLUDED | ADJUSTED

  run      HrPayrollRun      @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([vendorId, employeeId])
  @@map("hr_payroll_entries")
}

model HrBonus {
  id          String   @id @default(cuid())
  vendorId    String?
  employeeId  String
  type        String   // FESTIVAL | PERFORMANCE | TARGET | ATTENDANCE | SPECIAL
  amount      Decimal  @db.Decimal(14, 2)
  periodMonth Int?
  periodYear  Int?
  label       String?
  status      String   @default("PENDING") // PENDING | APPROVED | IN_PAYROLL | PAID | REJECTED
  createdBy   String?  // separation of duties: creator ≠ approver, enforce in service layer
  approvedBy  String?
  createdAt   DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_bonuses")
}

model HrDeduction {
  id         String   @id @default(cuid())
  vendorId   String?
  employeeId String
  type       String   // ABSENCE | LATE | ADVANCE | LOAN | OTHER
  label      String
  amount     Decimal  @db.Decimal(14, 2)
  month      Int
  year       Int
  recurring  Boolean  @default(false)
  status     String   @default("ACTIVE") // ACTIVE | IN_PAYROLL | PAID | STOPPED
  createdAt  DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_deductions")
}

// ============================ LOANS & ADVANCES ============================

model HrLoan {
  id                String    @id @default(cuid())
  vendorId          String?
  employeeId        String
  type              String    @default("PERSONAL") // PERSONAL | HOUSING | MEDICAL | EMERGENCY | OTHER
  principal         Decimal   @db.Decimal(14, 2)
  installmentAmount Decimal   @default(0) @db.Decimal(14, 2)
  installments      Int       @default(1)
  startDate         String
  paidAmount        Decimal   @default(0) @db.Decimal(14, 2)
  outstanding       Decimal   @default(0) @db.Decimal(14, 2)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | CLOSED
  purpose           String?
  approvedBy        String?
  actedAt           DateTime?
  createdAt         DateTime  @default(now())

  employee     HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  installments_ HrLoanInstallment[] @relation("LoanToInstallment")

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_loans")
}

model HrLoanInstallment {
  id         String    @id @default(cuid())
  loanId     String
  no         Int
  dueDate    String
  amount     Decimal   @db.Decimal(14, 2)
  paidAmount Decimal   @default(0) @db.Decimal(14, 2)
  paidAt     DateTime?
  status     String    @default("PENDING") // PENDING | PAID | PARTIAL | OVERDUE

  loan HrLoan @relation("LoanToInstallment", fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, no])
  @@map("hr_loan_installments")
}

model HrAdvance {
  id          String    @id @default(cuid())
  vendorId    String?
  employeeId  String
  amount      Decimal   @db.Decimal(14, 2)
  reason      String?
  requestDate String
  installments Int      @default(1)
  deducted    Decimal   @default(0) @db.Decimal(14, 2)
  outstanding Decimal   @default(0) @db.Decimal(14, 2)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | RECOVERING | RECOVERED
  approvedBy  String?
  actedAt     DateTime?
  createdAt   DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_advances")
}

model HrExpenseClaim {
  id             String    @id @default(cuid())
  vendorId       String?
  employeeId     String
  category       String    // TRAVEL | FOOD | MEDICAL | OFFICE | TRANSPORT | OTHER
  title          String
  amount         Decimal   @db.Decimal(14, 2)
  approvedAmount Decimal?  @db.Decimal(14, 2)
  date           String
  description    String?
  receiptUrl     String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | REIMBURSED
  approvedBy     String?
  actedAt        DateTime?
  createdAt      DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_expense_claims")
}

// ============================ APPROVAL WORKFLOW (generic) ============================

model HrApprovalWorkflow {
  id          String   @id @default(cuid())
  vendorId    String?
  name        String
  processType String   // LEAVE | LOAN | EXPENSE | ADVANCE | PROMOTION | TRANSFER | SALARY_REVISION | RESIGNATION
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps HrApprovalStep[]

  @@unique([vendorId, processType])
  @@map("hr_approval_workflows")
}

model HrApprovalStep {
  id              String  @id @default(cuid())
  workflowId      String
  sequence        Int
  name            String
  approverRole    String? // e.g. VENDOR, EMPLOYEE-with-orderManagement, or a specific HR role you define
  approverUserId  String? // User.id — specific approver
  amountThreshold Decimal? @db.Decimal(14, 2)
  required        Boolean @default(true)

  workflow HrApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("hr_approval_steps")
}

model HrApprovalRequest {
  id          String    @id @default(cuid())
  vendorId    String?
  workflowId  String
  processType String
  entityType  String    // HrLeaveRequest | HrLoan | HrExpenseClaim | ...
  entityId    String
  requestedBy String    // User.id
  currentStep Int       @default(1)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  actions HrApprovalAction[]

  @@index([vendorId, status])
  @@index([vendorId, processType])
  @@map("hr_approval_requests")
}

model HrApprovalAction {
  id        String   @id @default(cuid())
  requestId String
  step      Int
  userId    String?  // null = system auto-action
  action    String   // APPROVE | REJECT | SKIP
  comment   String?
  createdAt DateTime @default(now())

  request HrApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("hr_approval_actions")
}

// ============================ HR LETTERS ============================

model HrLetterTemplate {
  id                   String   @id @default(cuid())
  vendorId             String?
  type                 String   // APPOINTMENT | CONFIRMATION | SALARY_CERT | EMPLOYMENT_CERT | EXPERIENCE | INCREMENT | PROMOTION | TRANSFER | WARNING | NOC | CUSTOM
  name                 String
  subject              String
  body                 String   // with {{variables}}
  requiresApproval     Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([vendorId, type])
  @@map("hr_letter_templates")
}

model HrLetter {
  id             String    @id @default(cuid())
  vendorId       String?
  employeeId     String
  type           String
  templateId     String?
  letterNumber   String
  subject        String
  content        String    // rendered snapshot
  status         String    @default("DRAFT") // DRAFT | HR_REVIEW | APPROVED | ISSUED | REJECTED
  issuedAt       DateTime?
  approvedBy     String?
  createdBy      String?
  createdAt      DateTime  @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([vendorId, letterNumber])
  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_letters")
}

// ============================ RESIGNATION & EXIT ============================

model HrResignation {
  id              String    @id @default(cuid())
  vendorId        String?
  employeeId      String
  submissionDate  String
  resignationDate String
  proposedLwd     String    // last working day
  actualLwd       String?
  reason          String
  status          String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | ACCEPTED | REJECTED | WITHDRAWN | NOTICE_PERIOD | COMPLETED
  noticeDays      Int       @default(30)
  actedBy         String?
  actedAt         DateTime?
  createdAt       DateTime  @default(now())

  employee   HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clearance  HrExitClearance?
  settlement HrFinalSettlement?

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@map("hr_resignations")
}

model HrExitClearance {
  id            String   @id @default(cuid())
  vendorId      String?
  resignationId String   @unique
  checklistJson Json     @default("[]") // [{department, item, cleared, clearedBy, notes}]
  status        String   @default("PENDING") // PENDING | IN_PROGRESS | CLEARED
  clearedAt     DateTime?
  updatedAt     DateTime @updatedAt

  resignation HrResignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)

  @@map("hr_exit_clearances")
}

model HrFinalSettlement {
  id              String   @id @default(cuid())
  vendorId        String?
  resignationId   String   @unique
  computationJson Json     @default("{}") // {finalSalary, leaveEncashment, loanDue, advanceDue, netPayable}
  netPayable      Decimal  @default(0) @db.Decimal(14, 2)
  status          String   @default("DRAFT") // DRAFT | CALCULATED | APPROVED | PAID
  approvedBy      String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  resignation HrResignation @relation(fields: [resignationId], references: [id], onDelete: Cascade)

  @@map("hr_final_settlements")
}

// ============================ PERFORMANCE / KPI ============================

model HrReviewCycle {
  id        String   @id @default(cuid())
  vendorId  String?
  name      String   // "2026 Annual Performance Review"
  year      Int
  startDate String
  endDate   String
  status    String   @default("ACTIVE") // DRAFT | ACTIVE | CLOSED
  createdAt DateTime @default(now())

  reviews HrPerformanceReview[]

  @@index([vendorId])
  @@map("hr_review_cycles")
}

model HrPerformanceReview {
  id               String    @id @default(cuid())
  vendorId         String?
  cycleId          String
  employeeId       String
  reviewerId       String?   // User.id
  ratingsJson      Json      @default("{}")
  overallRating    Float     @default(0)
  managerComments  String?
  employeeComments String?
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | ACKNOWLEDGED | FINAL
  submittedAt      DateTime?
  createdAt        DateTime  @default(now())

  cycle    HrReviewCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([cycleId, employeeId])
  @@index([vendorId, employeeId])
  @@map("hr_performance_reviews")
}

model HrKpiTemplate {
  id            String   @id @default(cuid())
  vendorId      String?
  name          String
  designationId String?
  itemsJson     Json     @default("[]") // [{name, target, unit, weight}]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  assignments HrKpiAssignment[]

  @@index([vendorId])
  @@map("hr_kpi_templates")
}

model HrKpiAssignment {
  id          String   @id @default(cuid())
  vendorId    String?
  employeeId  String
  templateId  String?
  periodLabel String   // "2026-Q3"
  dueDate     String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | SUBMITTED | REVIEWED
  resultsJson Json     @default("[]")
  createdAt   DateTime @default(now())

  employee HrEmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  template HrKpiTemplate?    @relation(fields: [templateId], references: [id])

  @@index([vendorId, employeeId])
  @@index([vendorId, status])
  @@map("hr_kpi_assignments")
}

// ============================ TASKS, ANNOUNCEMENTS, MISC ============================

model HrTask {
  id            String   @id @default(cuid())
  vendorId      String?
  title         String
  description   String?
  assigneeId    String
  departmentId  String?
  branchId      String?
  priority      String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate       String?
  status        String   @default("TODO") // TODO | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  progress      Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignee HrEmployeeProfile @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([vendorId, assigneeId])
  @@index([vendorId, status])
  @@map("hr_tasks")
}

model HrAnnouncement {
  id           String    @id @default(cuid())
  vendorId     String?
  title        String
  body         String
  audienceType String    @default("ALL") // ALL | BRANCH | DEPARTMENT | DESIGNATION | SPECIFIC
  audienceIds  Json      @default("[]")
  pinned       Boolean   @default(false)
  publishedAt  DateTime?
  active       Boolean   @default(true)
  createdBy    String?
  createdAt    DateTime  @default(now())

  @@index([vendorId, active])
  @@map("hr_announcements")
}

model HrHoliday {
  id        String   @id @default(cuid())
  vendorId  String?
  branchId  String?  // null = all branches
  name      String
  date      String   // ISO date
  type      String   @default("PUBLIC") // PUBLIC | OPTIONAL | COMPANY
  createdAt DateTime @default(now())

  @@index([vendorId, date])
  @@map("hr_holidays")
}

model HrSetting {
  id        String   @id @default(cuid())
  vendorId  String?
  group     String   // general | attendance | leave | payroll | shift | notification
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([vendorId, group, key])
  @@map("hr_settings")
}

model HrNotification {
  id         String    @id @default(cuid())
  vendorId   String?
  userId     String?   // User.id — null = broadcast
  employeeId String?
  title      String
  message    String
  type       String    // LEAVE | PAYROLL | ATTENDANCE | TASK | LOAN | EXPENSE | DOC | LETTER | SYSTEM | ANNOUNCEMENT | EXIT
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([vendorId, userId])
  @@index([vendorId, employeeId])
  @@map("hr_notifications")
}

model CustomerProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  profileImage            String?
  gender                  Gender?
  dateOfBirth             DateTime?
  isVerifiedBySocialMedia Boolean   @default(false)
  wallet                  Float     @default(0)
  loyaltyPoints           Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DeliveryPerson {
  id                       String                    @id @default(cuid())
  userId                   String?
  name                     String
  phone                    String
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  conversationParticipants ConversationParticipant[]
  collections              DeliveryCollection[]
  payouts                  DeliveryPayout[]
  sentMessages             Message[]
  notificationSetting      NotificationSetting?

  @@map("delivery_persons")
}

model Conversation {
  id                String                    @id @default(cuid())
  type              ConversationType
  status            ConversationStatus        @default(OPEN)
  dedupeKey         String?                   @unique
  /// P10: AGENT_VENDOR only — the agent_vendor_links row this conversation belongs to
  agentLinkId       String?
  productId         String?
  orderId           String?
  title             String?
  lastMessageAt     DateTime?
  lastMessageText   String?
  lastMessageType   MessageType?
  lastSenderId      String?
  lastSenderType    ParticipantType?
  lastMessageStatus MessageStatus?
  messageCount      Int                       @default(0)
  /// 0=normal, 1=high, 2=urgent
  priority          Int                       @default(0)
  isSpam            Boolean                   @default(false)
  /// Auto-close timer
  expiresAt         DateTime?
  /// SLA deadline for first response
  slaResponseAt     DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  closedAt          DateTime?
  activities        ConversationActivity[]
  assignments       ConversationAssignment[]
  labels            ConversationLabel[]
  notes             ConversationNote[]
  participants      ConversationParticipant[]
  order             Order?                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@index([type, status, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([productId, lastMessageAt])
  @@index([orderId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([priority, lastMessageAt])
  @@index([createdAt])
  @@index([agentLinkId])
  @@map("conversations")
}

model ConversationParticipant {
  id                String            @id @default(cuid())
  conversationId    String
  participantType   ParticipantType
  userId            String?
  vendorId          String?
  employeeId        String?
  deliveryPersonId  String?
  /// P10: an agent participant (agents table); FK Restrict — history is never cascaded away
  agentId           String?
  /// Exact message cursor - no count queries needed
  lastReadMessageId String?
  lastReadAt        DateTime?
  unreadCount       Int               @default(0)
  joinedAt          DateTime          @default(now())
  leftAt            DateTime?
  isMuted           Boolean           @default(false)
  isPinned          Boolean           @default(false)
  notifyNewMessage  Boolean           @default(true)
  notifyMention     Boolean           @default(true)
  displayName       String?
  displayImage      String?
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent             Agent?            @relation("AgentChatParticipants", fields: [agentId], references: [id], onDelete: Restrict)
  deliveryPerson    DeliveryPerson?   @relation(fields: [deliveryPersonId], references: [id], onDelete: Cascade)
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor            Vendor?           @relation("VendorParticipants", fields: [vendorId], references: [id], onDelete: Cascade)
  reactions         MessageReaction[]
  receipts          MessageReceipt[]

  @@unique([conversationId, userId, vendorId, employeeId, deliveryPersonId])
  @@index([userId, isMuted])
  @@index([vendorId, isMuted])
  @@index([employeeId, isMuted])
  @@index([deliveryPersonId, isMuted])
  @@index([agentId, isMuted])
  @@index([conversationId, participantType])
  @@index([userId, unreadCount])
  @@map("conversation_participants")
}

model Message {
  id                     String            @id @default(cuid())
  conversationId         String
  messageType            MessageType       @default(TEXT)
  senderId               String?
  senderVendorId         String?
  senderEmployeeId       String?
  senderDeliveryPersonId String?
  /// P10: agent sender; FK Restrict
  senderAgentId          String?
  senderType             ParticipantType
  /// Null for IMAGE/AUDIO
  content                String?
  /// Lowercase for full-text search
  contentSearch          String?
  systemData             Json?
  quickReplyId           String?
  replyToId              String?
  status                 MessageStatus     @default(SENDING)
  /// Array of participant IDs who deleted
  deletedFor             String[]
  deletedAt              DateTime?
  createdAt              DateTime          @default(now())
  editedAt               DateTime?
  keywords               MessageKeyword[]
  media                  MessageMedia?
  reactions              MessageReaction[]
  receipts               MessageReceipt[]
  conversation           Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quickReply             QuickReply?       @relation(fields: [quickReplyId], references: [id])
  replyTo                Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies                Message[]         @relation("MessageReplies")
  senderAgent            Agent?            @relation("AgentChatMessages", fields: [senderAgentId], references: [id], onDelete: Restrict)
  senderDelivery         DeliveryPerson?   @relation(fields: [senderDeliveryPersonId], references: [id], onDelete: Cascade)
  senderEmployee         Employee?         @relation(fields: [senderEmployeeId], references: [id], onDelete: Cascade)
  senderUser             User?             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderVendor           Vendor?           @relation("VendorSentMessages", fields: [senderVendorId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@index([senderType, createdAt])
  @@index([status, createdAt])
  @@index([contentSearch])
  @@index([replyToId])
  @@index([senderAgentId, createdAt])
  @@map("messages")
}

model MessageMedia {
  id           String      @id @default(cuid())
  messageId    String      @unique
  mediaType    MediaType
  status       MediaStatus @default(PROCESSING)
  /// CDN URL (optimized)
  url          String
  /// Blurred thumbnail for images
  thumbnailUrl String?
  /// Original quality
  originalUrl  String?
  fileName     String?
  /// Bytes
  fileSize     Int?
  mimeType     String?
  width        Int?
  height       Int?
  /// Pre-calculated
  aspectRatio  Float?
  /// Placeholder while loading
  blurhash     String?
  /// Seconds
  duration     Int?
  /// Base64 encoded waveform for UI
  waveformData String?
  createdAt    DateTime    @default(now())
  message      Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([mediaType, status])
  @@map("message_media")
}

model MessageReceipt {
  id            String                  @id @default(cuid())
  messageId     String
  /// ConversationParticipant.id
  participantId String
  deliveredAt   DateTime?
  seenAt        DateTime?
  message       Message                 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   ConversationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([messageId])
  @@index([participantId, seenAt])
  @@map("message_receipts")
}

model MessageReaction {
  id            String                  @id @default(cuid())
  messageId     String
  participantId String
  /// Emoji character
  reaction      String
  createdAt     DateTime                @default(now())
  message       Message                 @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   ConversationParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
  @@index([messageId])
  @@map("message_reactions")
}

model ConversationAssignment {
  id             String           @id @default(cuid())
  conversationId String
  /// Employee/Admin/Vendor ID
  assigneeId     String
  assigneeType   ParticipantType
  assignedBy     String?
  assignedByType ParticipantType?
  note           String?
  assignedAt     DateTime         @default(now())
  unassignedAt   DateTime?
  isActive       Boolean          @default(true)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, isActive])
  @@index([assigneeId, isActive, assignedAt])
  @@index([assigneeType, isActive])
  @@map("conversation_assignments")
}

model ConversationActivity {
  id              String           @id @default(cuid())
  conversationId  String
  activityType    ActivityType
  performedBy     String?
  performedByType ParticipantType?
  oldValue        Json?
  newValue        Json?
  metadata        Json?
  createdAt       DateTime         @default(now())
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([activityType, createdAt])
  @@index([performedBy, createdAt])
  @@map("conversation_activities")
}

model ConversationLabel {
  id             String           @id @default(cuid())
  conversationId String
  label          String
  /// Hex: #FF5733
  color          String?
  addedBy        String?
  addedByType    ParticipantType?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, label])
  @@index([label])
  @@map("conversation_labels")
