/// Publication state of a review. PUBLISHED is the default, so every review
/// that exists today keeps counting toward Product.avgRating exactly as it does
/// now — the migration changes no rating.
enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Increment 2 ────────────────────────────────────────────────────────────
  /// The delivered order line that entitled this review. NULL for reviews
  /// written before the link existed — deliberately never backfilled: an
  /// unambiguous line cannot be inferred from (userId, productId) alone.
  orderItemId String? @unique
  /// Moderation/publication state. Defaults to PUBLISHED so nothing that exists
  /// today changes its contribution to the rating aggregates.
  status ReviewStatus @default(PUBLISHED)
  /// A single seller response per review (Phase 5).
  vendorReply         String?
  vendorReplyAt       DateTime?
  vendorReplyByUserId String?

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SET NULL: deleting the order line must never delete the customer's review.
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]
  comments  ReviewComment[]

  @@index([productId, status, createdAt])
  @@index([userId, productId])
  @@index([status])
  @@map("reviews")
}

/// Up to three images per review, held in positions 0–2. The migration also adds
/// a CHECK (position >= 0 AND position < 3) and the unique (reviewId, position),
/// so the database itself cannot store a fourth image.
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  /// Slot index 0–2; the range is enforced by the migration's CHECK constraint.
  position  Int
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, position])
  @@map("review_images")
}

/// A discussion comment on a review. `parentId` supports one level of replies;
/// a comment never affects the product's star rating.
model ReviewComment {
  id        String    @id @default(cuid())
  reviewId  String
  userId    String
  parentId  String?
  body      String
  /// Set when a moderator hides the comment; NULL = visible.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  review  Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Same-review enforcement: the parent must belong to THIS review. Mirrors
  /// the repo's existing composite-FK convention (VendorWarehouse id+vendorId →
  /// WarehouseCourierPickup). Depth ≤ 1 is a service rule — Prisma cannot express it.
  parent  ReviewComment?  @relation("ReviewCommentReplies", fields: [parentId, reviewId], references: [id, reviewId], onDelete: Cascade)
  replies ReviewComment[] @relation("ReviewCommentReplies")

  @@unique([id, reviewId])
  @@index([reviewId, createdAt])
  @@index([parentId])
  @@map("review_comments")
}

