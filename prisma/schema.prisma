  @@map("offer_analytics")
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String?           @unique
  userId                String?
  totalAmount           Decimal           @db.Decimal(18, 4)
  subtotal              Decimal?          @db.Decimal(18, 4)
  shippingCost          Decimal?          @default(0) @db.Decimal(18, 4)
  tax                   Decimal?          @default(0) @db.Decimal(18, 4)
  discountAmount        Decimal?          @default(0) @db.Decimal(18, 4)
  status                OrderStatus
  paymentStatus         PaymentStatus     @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(UNFULFILLED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  confirmedAt           DateTime?
  paidAt                DateTime?
  cancelledAt             DateTime?
  reservationReleasedAt   DateTime?
  conversionSource      String?
  deviceType            String?
  paymentmethod         PaymentMethod
  codVerificationStatus String?
  riskScore             Decimal?          @default(0) @db.Decimal(5, 2)
  checkoutSessions      CheckoutSession?
  conversations         Conversation[]
  courierOrders         CourierOrder[]
  offerUsages           OfferUsage[]
  address               OrderAddress?
  user                  User?             @relation(fields: [userId], references: [id])
  payments              Payment[]
  refunds               Refund[]
  vendorOrders          VendorOrder[]
  vouchers              Voucher[]
  promotionRedemptions PromotionRedemption[]
  itemDiscounts        OrderItemDiscount[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@index([userId])
  @@map("orders")
}

model VendorOrder {
  id                  String               @id @default(cuid())
  orderId             String
  vendorId            String
  subtotal            Decimal              @db.Decimal(18, 4)
  shippingCost        Decimal              @default(0) @db.Decimal(18, 4)
  status              OrderStatus
  fulfillmentStatus   FulfillmentStatus    @default(UNFULFILLED)
  createdAt           DateTime             @default(now())
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  courierOrderId      String?
  courierOrders       CourierOrder[]
  deliveryCollections DeliveryCollection[]
  items               OrderItem[]
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor              Vendor               @relation(fields: [vendorId], references: [id])
  promotionRedemptions PromotionRedemption[]
  itemDiscounts        OrderItemDiscount[]

  @@index([orderId])
  @@index([vendorId])
    returns              VendorReturn[]

  @@map("vendor_orders")
}

model OrderItem {
  id                String                @id @default(cuid())
  vendorOrderId     String
  variantId         String
  quantity          Int
  price             Decimal               @db.Decimal(18, 4)
  // PHASE 2 BATCH 1C-2c: immutable sale-time tax snapshot (null = legacy line)
  taxRate           Decimal?              @db.Decimal(18, 4)
  taxAmount         Decimal?              @db.Decimal(18, 4)
  taxTreatment      TaxTreatment?
  unitCost          Decimal?              @db.Decimal(18, 4)
  deliveredQuantity Int                   @default(0)
  returnedQuantity  Int                   @default(0)
  allocations       OrderItemAllocation[]
  variant           ProductVariant        @relation(fields: [variantId], references: [id])
  vendorOrder       VendorOrder           @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

    returnItems          VendorReturnItem[]
  /// Marketing Center: price before promotions, and where the unit price came from (null = legacy line).
  listPrice   Decimal?         @db.Decimal(18, 4)
  priceSource ItemPriceSource?
  discounts   OrderItemDiscount[]

  /// Reviews written against this delivered line (Increment 2).
  reviews     Review[]

  @@map("order_items")
}

model OrderItemAllocation {
  id             String          @id @default(cuid())
  orderItemId    String
  warehouseId    String
  rackId         String?
  rowNumber      Int?
  shelfNumber    Int?
  quantity       Int
  reservedQty    Int             @default(0)
