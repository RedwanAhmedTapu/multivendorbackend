// ─────────────────────────────────────────────────────────────
// BLOG MODULE — schema additions
// Merge these into your existing schema.prisma. `BlogPost`,
// `FooterSettings`/`FooterColumn`/`FooterElement` already exist in your
// schema — this file ADDS FIELDS to BlogPost (see the block below) and
// ADDS NEW MODELS. It does NOT touch FooterSettings — the blog gets its
// OWN footer (BlogFooterSettings) because it lives on a different
// subdomain with different content (About Finixmart Blog, blog
// categories, etc.), not your storefront's trade-license footer.
// ─────────────────────────────────────────────────────────────

// ── 1. ADD THESE FIELDS to your existing `model BlogPost { ... }` ──
//
//   categoryId       String?
//   excerpt          String?
//   featuredImage    String?   // R2 KEY only (e.g. "admin/blog/169..-x.jpg"), NOT a full URL
//   featuredImageAlt String?
//   readTimeMinutes  Int?
//   viewCount        Int              @default(0)
//   tags             String[]         @default([])
//   status           BlogPostStatus   @default(DRAFT)
//   scheduledAt      DateTime?
//   metaTitle        String?          @db.VarChar(60)
//   metaDescription  String?          @db.VarChar(160)
//   canonicalUrl     String?
//   ogImage          String?   // R2 KEY only, NOT a full URL
//   isAutoGeneratedSeo Boolean        @default(true)
//
//   category         BlogCategory?    @relation(fields: [categoryId], references: [id])
//   references       BlogPostReference[]
//   revisions        BlogPostRevision[]
//
//   @@index([categoryId, status, publishedAt])
//   @@index([status, publishedAt])
//   @@index([slug])
//
// `published Boolean` / `publishedAt` stay as-is for backward
// compatibility — `status` is the new source of truth going forward,
// `publishedAt` is still set the moment status flips to PUBLISHED.

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model BlogCategory {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      BlogCategory?  @relation("BlogCategoryToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    BlogCategory[] @relation("BlogCategoryToChildren")
  posts       BlogPost[]

  @@index([parentId, sortOrder])
  @@map("blog_categories")
}

// Inline "compare with other sites" / external reference links rendered
// as cards inside a post (price comparison table, source links, etc.)
model BlogPostReference {
  id        String   @id @default(cuid())
  postId    String
  label     String
  url       String
  price     Float?
  source    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("blog_post_references")
}

// Lightweight version history so an editor can revert a published post.
model BlogPostRevision {
  id        String   @id @default(cuid())
  postId    String
  title     String
  body      String
  editedBy  String?
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("blog_post_revisions")
}

// Two-layer dropdown nav (Discover, Fashion, Electronics, Beauty, ... each
// with children) — fully admin/employee editable, matches the reference
// screenshots' top nav.
model BlogNavItem {
  id           String        @id @default(cuid())
  label        String
  url          String?
  parentId     String?
  sortOrder    Int           @default(0)
  isVisible    Boolean       @default(true)
  openInNewTab Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parent       BlogNavItem?  @relation("BlogNavToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     BlogNavItem[] @relation("BlogNavToChildren")

  @@index([parentId, sortOrder])
  @@map("blog_nav_items")
}

// Site-wide identity/branding for the blog subdomain — logo, name, colors.
// Kept separate from your storefront's Theme/Setting models since it's a
// different property (blog.finixmart.com.bd) with its own brand assets.
model BlogSiteSettings {
  id               String   @id @default(cuid())
  siteName         String   @default("Finixmart Blog")
  logoUrl          String?  // R2 KEY only, NOT a full URL
  faviconUrl       String?  // R2 KEY only, NOT a full URL
  tagline          String?
  primaryColorHex  String   @default("#0F766E") // teal
  backgroundHex    String   @default("#FAF7F2") // warm white
  textColorHex     String   @default("#374151") // gray
  defaultOgImage   String?  // R2 KEY only, NOT a full URL
  googleAnalyticsId String?
  updatedAt        DateTime @updatedAt

  @@map("blog_site_settings")
}

// Blog's own footer — same shape/spirit as your existing FooterSettings
// so it feels familiar to admins, but scoped to the blog.
model BlogFooterSettings {
  id                    String             @id @default(cuid())
  aboutTitle            String             @default("About Us")
  aboutText             String
  facebookUrl           String?
  youtubeUrl            String?
  instagramUrl          String?
  linkedinUrl           String?
  twitterUrl            String?
  copyrightText         String
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  columns               BlogFooterColumn[]

  @@map("blog_footer_settings")
}

model BlogFooterColumn {
  id                   String              @id @default(cuid())
  title                String
  sortOrder            Int                 @default(0)
  isVisible            Boolean             @default(true)
  footerSettingsId     String
  footerSettings       BlogFooterSettings  @relation(fields: [footerSettingsId], references: [id], onDelete: Cascade)
  elements             BlogFooterElement[]

  @@index([footerSettingsId, sortOrder])
  @@map("blog_footer_columns")
}

model BlogFooterElement {
  id             String           @id @default(cuid())
  label          String
  url            String
  sortOrder      Int              @default(0)
  isVisible      Boolean          @default(true)
  openInNewTab   Boolean          @default(false)
  footerColumnId String
  footerColumn   BlogFooterColumn @relation(fields: [footerColumnId], references: [id], onDelete: Cascade)

  @@index([footerColumnId, sortOrder])
  @@map("blog_footer_elements")
}

// ── Migration notes ──────────────────────────────────────────
// 1. Add the BlogPost fields listed in the comment block above, plus the
//    enum, then add the six new models as-is.
// 2. `npx prisma migrate dev --name blog-module-additions`
// 3. Seed one BlogSiteSettings row and one BlogFooterSettings row (with
//    its columns/elements) — the public API 500s without them since the
//    blog site always needs a settings/footer object to render.
