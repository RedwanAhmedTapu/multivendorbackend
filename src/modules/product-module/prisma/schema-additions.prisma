// ---- Product: soft-delete + delayed purge + slug history ----
// Add these fields to the existing `Product` model:
//
//   isDeleted         Boolean   @default(false)
//   deletedAt         DateTime?
//   deletedById       String?
//   scheduledPurgeAt  DateTime?      // deletedAt + 90 days; purge job reads this
//   previousSlugs     ProductSlugHistory[]
//   viewCount         Int       @default(0)
//   wishlistCount     Int       @default(0)
//   salesCount        Int       @default(0)
//   isFeatured        Boolean   @default(false)
//   recentlyViewedBy  RecentlyViewedProduct[]
//
// Add indexes:
//   @@index([isDeleted, scheduledPurgeAt])
//   @@index([approvalStatus, isDeleted])
//   @@index([slug])
//   @@index([isFeatured])
//
// NOTE: because of the 90-day soft-delete window, EVERY public/vendor/admin
// query in this module filters `isDeleted: false` explicitly (see
// repositories/product.repository.ts). Do not rely on a global Prisma
// middleware for this — deletion visibility differs per role (admin can
// still see soft-deleted products in a dedicated "trash" view).

// Full-text search (Postgres) — Prisma can't model tsvector natively,
// add via a raw SQL migration:
//
//   ALTER TABLE products ADD COLUMN search_vector tsvector
//     GENERATED ALWAYS AS (
//       setweight(to_tsvector('simple', coalesce(name,'')), 'A') ||
//       setweight(to_tsvector('simple', coalesce("nameBn",'')), 'A') ||
//       setweight(to_tsvector('simple', coalesce(description,'')), 'C')
//     ) STORED;
//   CREATE INDEX product_search_idx ON products USING GIN (search_vector);

model ProductSlugHistory {
  id        String   @id @default(cuid())
  productId String
  oldSlug   String   @unique
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

// ---- ProductSEO: auto-generation bookkeeping ----
// Add to `ProductSEO`:
//   isAutoGenerated   Boolean   @default(true) // false once someone edits it manually
//   generatedAt       DateTime?
//   generatedTrigger  String?   // "APPROVAL" | "MANUAL" | "UPDATE"

// ---- RecentlyViewed (for "Recently Viewed Products") ----
model RecentlyViewedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_products")
}
